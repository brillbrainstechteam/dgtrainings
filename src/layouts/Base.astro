---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import LogoIntro from '../components/LogoIntro.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { CONTACT, SIGNATURE, PROGRAMS, GROUPS, bySlug, tel, wa, progUrl, plain } from '../lib/site';
import { photo } from '../lib/photos';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string; description: string; active?: string; header?: 'transparent' | 'solid';
  /** Photo shown when the page is shared (WhatsApp, LinkedIn, Facebook…); defaults to a training-floor photo. */
  image?: ImageMetadata;
  /** Trail for the breadcrumb rich result, e.g. [['Programs', '/programs/'], ['Marketing', '/programs/marketing-training/']] */
  crumbs?: [string, string][];
  /** Extra schema.org JSON-LD objects for this page (Course, FAQPage, Person…). */
  schema?: Record<string, unknown>[];
  /** Keep this page out of search results (404). */
  noindex?: boolean;
}
const { title, description, active, header = 'transparent', image = photo('safalta-sangam/05'), crumbs = [], schema = [], noindex = false } = Astro.props;
const fullTitle = title.includes('DG Trainings') ? title : `${title} | DG Trainings`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Google shows ~155 characters of a description; cut long intros at a word boundary
const desc = plain(description);
const metaDescription = desc.length <= 158 ? desc : desc.slice(0, 155).replace(/[\s,;:—–-]+\S*$/, '') + '…';
const ogImage = new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site);
const SITE = Astro.site!.href;
const ORG_ID = `${SITE}#organization`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'EducationalOrganization', '@id': ORG_ID,
    name: 'DG Trainings', alternateName: 'DG Trainings — Power to Performance', url: SITE,
    logo: new URL('/logo.png', SITE).href, image: ogImage.href,
    description: 'Business, sales, leadership and culture training for jewellery retailers, wholesalers and manufacturers, led by Dipen Ghatalia (DG).',
    email: CONTACT.email, telephone: CONTACT.phone_training,
    address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressRegion: 'Maharashtra', addressCountry: 'IN' },
    areaServed: 'IN', founder: { '@type': 'Person', name: 'Dipen Ghatalia' },
    parentOrganization: { '@type': 'Organization', name: 'BrillBrains Consultants Pvt. Ltd.', url: CONTACT.brillbrains },
    sameAs: [CONTACT.instagram, CONTACT.facebook, CONTACT.youtube],
    contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer service', telephone: CONTACT.phone_training, email: CONTACT.email, areaServed: 'IN' }],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE}#website`, name: 'DG Trainings', url: SITE, inLanguage: 'en-IN', publisher: { '@id': ORG_ID } },
  ...(crumbs.length ? [{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [['Home', '/'] as [string, string], ...crumbs].map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(path, SITE).href })),
  }] : []),
  ...schema.map((s) => ({ '@context': 'https://schema.org', ...s })),
];
// Programs menu: grouped into three themes, with short labels that scan quickly
const MENU = GROUPS.map((g) => ({ title: g.title, items: g.items.map(([slug, label]) => [bySlug(slug), label] as const) }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && location.search.indexOf('static') < 0) document.documentElement.classList.add('motion'); setTimeout(function () { if (!window.__dgMotion) document.documentElement.classList.remove('motion'); }, 3000);</script>
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
  <meta property="og:site_name" content="DG Trainings" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#232426" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/logo.png" type="image/png" sizes="600x600" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
  <ClientRouter fallback="swap" />
</head>
<body data-header={header}>
  <LogoIntro />
  <a class="skip" href="#main">Skip to content</a>
  <div class="scroll-progress" aria-hidden="true"><i></i></div>
  <div class="topbar">
    <div class="wrap">
      <div class="tb-l">
        <a href={tel(CONTACT.phone_training)}>{CONTACT.phone_training}</a>
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </div>
      <div class="tb-r">
        <span class="tb-social">
          <a href={CONTACT.instagram} target="_blank" rel="noopener" aria-label="DG Trainings on Instagram"><Icon name="instagram" /></a>
          <a href={CONTACT.facebook} target="_blank" rel="noopener" aria-label="DG Trainings on Facebook"><Icon name="facebook" /></a>
          <a href={CONTACT.youtube} target="_blank" rel="noopener" aria-label="DG Trainings on YouTube"><Icon name="youtube" /></a>
        </span>
        <a class="wa" href={wa()} target="_blank" rel="noopener">WhatsApp us</a>
        <a href={CONTACT.brillbrains} target="_blank" rel="noopener">A BrillBrains company</a>
      </div>
    </div>
  </div>
  <header class="header">
    <div class="wrap">
      <a href="/" class="logo" aria-label="DG Trainings — home"><BrandLogo id="hd" /></a>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
      <nav class="nav" id="nav" aria-label="Main">
        <div class="dd">
          <a href="/programs/" class:list={{ active: active === 'programs' }}>Our Programs</a>
          <div class="dd-menu">
            <div class="dd-cols">
              {MENU.map((g) => (
                <div class="dd-col">
                  <span class="dd-h">{g.title}</span>
                  {g.items.map(([p, label]) => (
                    <a href={progUrl(p)}><b>{p.num}</b><span><strong>{label}</strong><small>{p.tagline}</small></span></a>
                  ))}
                </div>
              ))}
            </div>
            <a class="dd-all" href="/programs/">View all {PROGRAMS.length} programs <Icon name="arrow" /></a>
          </div>
        </div>
        <a href="/approach/" class:list={{ active: active === 'approach' }}>Approach</a>
        <a href="/about-dg/" class:list={{ active: active === 'about' }}>About DG</a>
        <a href="/contact/" class:list={{ active: active === 'contact' }}>Contact Us</a>
        <a href="/contact/" class="btn btn--sm">Book a Training</a>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap">
      <div class="fgrid">
        <div>
          <a href="/" class="logo" aria-label="DG Trainings — home"><BrandLogo id="ft" /></a>
          <p>Business training for the jewellery industry, in partnership with <a class="bb" href={CONTACT.brillbrains} target="_blank" rel="noopener">BrillBrains Consultants</a> (Strategic &amp; Creative Forever).</p>
          <a class="faddr" href={CONTACT.map} target="_blank" rel="noopener"><Icon name="pin" /><span>{CONTACT.address.replace(/^BrillBrains Consultants Pvt\. Ltd\., /, '')}</span></a>
          <div class="social">
            <span class="social-k">Follow DG</span>
            <a href={CONTACT.instagram} target="_blank" rel="noopener" class="s-ig"><Icon name="instagram" /><span>Instagram</span></a>
            <a href={CONTACT.facebook} target="_blank" rel="noopener" class="s-fb"><Icon name="facebook" /><span>Facebook</span></a>
            <a href={CONTACT.youtube} target="_blank" rel="noopener" class="s-yt"><Icon name="youtube" /><span>YouTube</span></a>
          </div>
        </div>
        <div>
          <h4>Programs</h4>
          <ul>{SIGNATURE.slice(0, 5).map((p) => <li><a href={progUrl(p)}>{p.name}</a></li>)}</ul>
        </div>
        <div>
          <h4>More programs</h4>
          <ul>{PROGRAMS.slice(5).map((p) => <li><a href={progUrl(p)}>{p.name}</a></li>)}</ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="/about-dg/">About the Trainer</a></li>
            <li><a href={CONTACT.brillbrains} target="_blank" rel="noopener">Consulting Services</a></li>
            <li><a href={CONTACT.brillbrains} target="_blank" rel="noopener">Hiring Solutions</a></li>
            <li><a href="/approach/">Our Approach</a></li>
            <li><a href="/contact/#faq">FAQs</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="fbottom">
        <span>© {new Date().getFullYear()} <a href={CONTACT.brillbrains} target="_blank" rel="noopener">BrillBrains Consultants Pvt. Ltd.</a> All rights reserved.</span>
        <nav aria-label="Legal"><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-and-conditions/">Terms &amp; Conditions</a></nav>
      </div>
    </div>
  </footer>

  <a class="wa-float" href={wa()} target="_blank" rel="noopener" aria-label="Chat with DG Trainings on WhatsApp"><Icon name="whatsapp" /></a>

  <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <img src="" alt="" />
    <button class="lb-btn lb-close" type="button" aria-label="Close"><Icon name="x" /></button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo"><Icon name="arrow" class="flip" /></button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo"><Icon name="arrow" /></button>
    <span class="lb-count"></span>
  </dialog>

  <script>
    import '../scripts/motion';
    (window as any).__dgMotion = true;
  </script>
  <style is:global>.flip { transform: scaleX(-1); }</style>
</body>
</html>
