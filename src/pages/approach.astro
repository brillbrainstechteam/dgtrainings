---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { HOME as H, rich } from '../lib/site';
import { photo } from '../lib/photos';

// Four stages as a connected timeline, each with a photo of that stage in practice.
const stages = [
  { icon: 'search', key: 'Listen first', img: 'shivam-jewels/04', alt: 'DG in conversation with a client before the program', practice: [
    'Conversations with owners, managers and HR',
    'Your store, team and processes studied first-hand',
    'The numbers to track agreed up front',
  ] },
  { icon: 'pen', key: 'Built for you', img: 'vchains/01', alt: 'DG presenting a session built for the VChains team, in their own boardroom', practice: [
    'Examples built on your own collections and customers',
    'Scripts that sound like your brand',
    'Checklists and scorecards for your systems',
  ] },
  { icon: 'play', key: 'Learn by doing', img: 'shivam-jewels/07', alt: 'DG working the room in a full-house interactive session', practice: [
    'At your showroom, office or factory',
    'At a venue of your choice',
    'In the field — on tours and at exhibitions',
  ], places: [
    { img: 'saheli-aurum/04', label: 'Showroom' },
    { img: 'unique-factory/04', label: 'Factory' },
    { img: 'gitanjali-2026/03', label: 'Outdoors' },
  ] },
  { icon: 'refresh', key: 'Make it stick', img: 'paras-gold/03', alt: 'A trained team together after the program', practice: [
    'Follow-ups that keep new habits alive',
    'Before-and-after trackers, so change is visible',
    'Support for the managers who lead it',
  ] },
];
---
<Base title="Our Approach — How DG Trainings Works" description={H.approach_intro} active="approach">
  <section class="phero phero--simple on-dark">
    <div class="phero-bg"><Image src={photo('dc/01')} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="chev-deco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb" data-hero><a href="/">Home</a><span>/</span><span aria-current="page">Our Approach</span></nav>
        <span class="eyebrow" data-hero>Our approach</span>
        <h1 data-split>A structured approach to <em>lasting change</em></h1>
        <p class="lead" data-hero>No off-the-shelf slides. Every engagement begins with your business and ends with behaviour your customers can see and feel.</p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="head center"><span class="eyebrow">Four stages</span><h2 data-split>From first conversation to <em>measurable progress</em></h2></div>
      <ol class="tl" role="list">
        {H.steps.map(([t, d], i) => {
          const s = stages[i];
          return (
            <li class:list={['tl-row', { 'tl-row--flip': i % 2 === 1 }]}>
              <span class="tl-node" aria-hidden="true"><Icon name={s.icon} /></span>
              <div class="tl-media" data-reveal>
                <div class="tl-photo"><Image src={photo(s.img)} alt={s.alt} widths={[500, 900]} sizes="(max-width: 960px) 92vw, 520px" /></div>
                <span class="tl-tag">{s.key}</span>
                {s.places && (
                  <div class="tl-places">
                    {s.places.map((pl) => <figure><Image src={photo(pl.img)} alt="" width={240} height={180} /><figcaption>{pl.label}</figcaption></figure>)}
                  </div>
                )}
              </div>
              <div class="tl-body" data-reveal>
                <span class="tl-n">Stage {String(i + 1).padStart(2, '0')}</span>
                <h3>{t}</h3>
                <p>{d}</p>
                <ul>{s.practice.map((x) => <li set:html={rich(x)} />)}</ul>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <CtaBand heading="Start with a conversation." text="Tell us about your team and your goals — the first stage is always listening." primary="Book a Free Discovery Call" bg="paras-gold/05" compact />
</Base>

<style>
  .tl { position: relative; list-style: none; margin: 0 auto; padding: 0; max-width: 1120px; display: grid; gap: clamp(48px, 6vw, 88px); }
  /* the spine that connects the four stages */
  .tl::before { content: ""; position: absolute; left: 50%; top: 24px; bottom: 24px; width: 2px; transform: translateX(-50%); background: linear-gradient(var(--teal), var(--teal-ink)); opacity: .5; }
  .tl-row { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(56px, 8vw, 120px); align-items: center; }
  .tl-row--flip .tl-media { order: 2; }
  .tl-node { position: absolute; left: 50%; top: 50%; z-index: 2; translate: -50% -50%; width: 56px; height: 56px; border-radius: 18px; display: grid; place-items: center; color: #fff; background: linear-gradient(140deg, var(--teal), var(--teal-ink)); box-shadow: 0 0 0 8px #fff, 0 14px 30px -12px rgba(15,113,104,.7); rotate: 45deg; }
  .tl-node :global(svg) { width: 24px; height: 24px; rotate: -45deg; }
  .tl-media { position: relative; isolation: isolate; }
  .tl-photo { position: relative; aspect-ratio: 4 / 3; border-radius: 26px; overflow: hidden; box-shadow: var(--shadow-lg); }
  .tl-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(16,24,24,.55)); }
  .tl-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .tl-row:hover .tl-photo :global(img) { transform: scale(1.05); }
  .tl-media::before { content: ""; position: absolute; inset: 18px -18px -18px 18px; z-index: -1; border-radius: 26px; border: 2px solid var(--teal-100); background: var(--teal-50); }
  .tl-row--flip .tl-media::before { inset: 18px 18px -18px -18px; }
  .tl-tag { position: absolute; left: 18px; bottom: 18px; z-index: 1; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--grey-950); background: var(--teal); padding: 8px 14px; border-radius: 999px; }
  .tl-places { position: absolute; right: -14px; bottom: -34px; z-index: 2; display: flex; gap: 8px; }
  .tl-places figure { margin: 0; width: 96px; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 14px 30px -14px rgba(0,0,0,.45); border: 3px solid #fff; }
  .tl-places :global(img) { display: block; width: 100%; height: 66px; object-fit: cover; }
  .tl-places figcaption { font-size: .66rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; text-align: center; padding: 4px 0 2px; color: var(--ink); }
  .tl-n { font-size: .74rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--teal-ink); }
  .tl-body h3 { font-size: clamp(2.1rem, 3.6vw, 3rem); margin: 6px 0 10px; }
  .tl-body p { font-size: 1.06rem; color: var(--muted); margin: 0 0 18px; }
  .tl-body ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .tl-body li { position: relative; padding: 11px 14px 11px 40px; border-radius: 14px; background: var(--grey-50); border: 1px solid var(--grey-100); font-size: .93rem; font-weight: 600; color: var(--ink); }
  .tl-body li::before { content: ""; position: absolute; left: 15px; top: 16px; width: 12px; height: 9px; background: var(--teal-600); clip-path: polygon(0 0, 50% 0, 100% 50%, 50% 100%, 0 100%, 50% 50%); }
  @media (max-width: 960px) {
    .tl::before { left: 27px; transform: none; }
    .tl-row { grid-template-columns: 1fr; gap: 22px; padding-left: 72px; }
    .tl-row--flip .tl-media { order: 0; }
    .tl-node { left: 0; top: 0; translate: 0 0; width: 54px; height: 54px; }
    .tl-media::before { display: none; }
    .tl-places { position: static; margin-top: 10px; }
    .tl-places figure { flex: 1; width: auto; }
  }
  @media (max-width: 560px) {
    .tl-row { padding-left: 0; }
    .tl::before, .tl-node { display: none; }
    .tl-photo { border-radius: 20px; }
  }
</style>
