---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" noindex description="The page you were looking for has moved or no longer exists. Explore DG Trainings’ programs for jewellery businesses.">
  <section class="phero phero--simple on-dark">
    <div class="wrap">
      <div>
        <span class="eyebrow" data-hero>404</span>
        <h1 data-split>This page has <em>moved</em></h1>
        <p class="intro" data-hero>The page you were looking for doesn’t exist any more. Try one of these instead.</p>
        <div class="btns" data-hero>
          <a href="/" class="btn btn--teal">Home <Icon name="arrow" class="arr" /></a>
          <a href="/programs/" class="btn btn--ghost">Training Programs</a>
          <a href="/contact/" class="btn btn--ghost">Contact</a>
        </div>
      </div>
    </div>
  </section>
</Base>
