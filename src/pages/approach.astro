---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { HOME as H, PROGRAMS, progUrl, rich } from '../lib/site';
import { photo } from '../lib/photos';

// What each stage looks like in practice (drawn from the program sheets and FAQs)
const stages = [
  { icon: 'search', img: 'dishaa-platinum/01', alt: 'Working session with a leadership team', practice: [
    'Conversations with owners, managers and HR',
    'Your store, team, processes and goals studied first-hand',
    'The numbers to track agreed before training starts',
  ] },
  { icon: 'pen', img: 'unique-factory/02', alt: 'DG mapping out a session plan on the whiteboard', practice: [
    'Examples, role-plays and FAQs built on your own collections and customers',
    'Scripts tailored to your brand, offers and customers — so they sound natural',
    'Checklists, templates and scorecards adapted to your systems',
  ] },
  { icon: 'play', img: 'shivam-jewels/02', alt: 'A full-house interactive session', practice: [
    'On-site at your showroom, office or factory',
    'At a venue of your choice',
    'In the field — during sales tours and exhibitions',
  ] },
  { icon: 'refresh', img: 'dp/06', alt: 'Flip-chart follow-up session on the showroom floor', practice: [
    'Follow-ups after the program to keep new habits alive',
    'Simple before/after trackers, so the change is visible',
    'Materials your team keeps for future batches [Confirm]',
  ] },
];
const venues = [
  { label: 'The showroom floor', text: 'Between the counters your team works at every day', img: 'saheli-aurum/04' },
  { label: 'Office or factory', text: 'With real products in hand', img: 'unique-factory/04' },
  { label: 'A venue of your choice', text: 'For large teams and full-company sessions', img: 'shivam-jewels/06' },
  { label: 'In the field', text: 'On sales tours and at exhibitions', img: 'gitanjali-2026/03' },
];
const measured = PROGRAMS.filter((p) => p.impact);
---
<Base title="Our Approach — How DG Trainings Works" description={H.approach_intro} active="approach">
  <section class="phero phero--simple on-dark">
    <div class="phero-bg"><Image src={photo('dc/01')} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="chev-deco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb" data-hero><a href="/">Home</a><span>/</span><span aria-current="page">Our Approach</span></nav>
        <span class="eyebrow" data-hero>Our approach</span>
        <h1 data-split>A structured approach to <em>lasting change</em></h1>
        <p class="lead" data-hero>{H.approach_intro}</p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="head head--row">
        <div><span class="eyebrow">Four stages</span><h2 data-split>What happens <em>at every stage</em></h2></div>
        <p class="lead" data-reveal>Every engagement follows the same four stages — the detail inside each one is built around your business.</p>
      </div>
      <ol class="ap-stages" role="list">
        {H.steps.map(([t, d], i) => (
          <li class="ap-stage">
            <div class="frame ap-photo" data-img><Image src={photo(stages[i].img)} alt={stages[i].alt} widths={[500, 900]} sizes="(max-width: 960px) 100vw, 540px" /></div>
            <div class="ap-body" data-reveal>
              <span class="ap-n"><Icon name={stages[i].icon} /> Stage {String(i + 1).padStart(2, '0')}</span>
              <h3>{t}</h3>
              <p class="lead">{d}</p>
              <h4>In practice</h4>
              <ul class="ticks ticks--1">{stages[i].practice.map((x) => <li set:html={rich(x)} />)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Where training happens</span><h2 data-split>We come to <em>where your team works</em></h2></div>
      <div class="ap-venues" data-stagger>
        {venues.map((v) => (
          <figure class="ap-venue">
            <Image src={photo(v.img)} alt="" widths={[400, 700]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 300px" />
            <figcaption><b>{v.label}</b><span>{v.text}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="head head--row">
        <div><span class="eyebrow">What we measure</span><h2 data-split>Progress you can <em>see in the numbers</em></h2></div>
        <p class="lead" data-reveal>Before each program we agree what to track, then compare before and after.</p>
      </div>
      <div class="ap-measure" data-stagger>
        {measured.map((p) => (
          <a class="ap-m" href={progUrl(p)}>
            <span class="ap-m-n">{p.num}</span>
            <b>{p.short === 'LWCT' ? 'Life & Work Culture' : p.short}</b>
            <p>{p.impact}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand heading="Start with a conversation." text="Tell us about your team and your goals — the first stage is always listening." primary="Book a Free Discovery Call" bg="paras-gold/05" compact />
</Base>

<style>
  .ap-stages { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(36px, 5vw, 64px); }
  .ap-stage { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .ap-stage:nth-child(even) .ap-photo { order: 2; }
  .ap-photo { aspect-ratio: 4/3; }
  .ap-n { display: inline-flex; align-items: center; gap: 10px; font-size: .74rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--teal-ink); }
  .ap-n :global(svg) { width: 32px; height: 32px; padding: 7px; border-radius: 10px; background: var(--grey-900); color: var(--teal); }
  .ap-body h3 { font-size: clamp(2rem, 3.4vw, 2.8rem); margin: 10px 0 8px; }
  .ap-body h4 { font-size: .74rem; letter-spacing: .16em; text-transform: uppercase; color: var(--grey-500); margin: 18px 0 0; }
  .ap-venues { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .ap-venue { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 3/4; isolation: isolate; }
  .ap-venue :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--ease); }
  .ap-venue::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 35%, rgba(25,26,28,.9)); }
  .ap-venue:hover :global(img) { transform: scale(1.06); }
  .ap-venue figcaption { position: absolute; left: 20px; right: 20px; bottom: 20px; color: #fff; }
  .ap-venue b { display: block; font-family: var(--display); font-size: 1.4rem; font-weight: 600; }
  .ap-venue span { font-size: .86rem; color: rgba(255,255,255,.8); }
  .ap-measure { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .ap-m { display: block; background: #fff; border: 1px solid var(--grey-200); border-radius: var(--radius); padding: 20px 22px; transition: border-color .3s, transform .4s var(--ease), box-shadow .4s; }
  .ap-m:hover { border-color: var(--teal); transform: translateY(-3px); box-shadow: var(--shadow); }
  .ap-m-n { font-family: var(--display); color: var(--teal-ink); font-size: 1.3rem; font-weight: 600; margin-right: 8px; }
  .ap-m b { font-size: 1.05rem; color: var(--ink); }
  .ap-m p { margin: 8px 0 0; font-size: .9rem; color: var(--muted); }
  @media (max-width: 960px) { .ap-stage { grid-template-columns: 1fr; } .ap-stage:nth-child(even) .ap-photo { order: 0; } .ap-venues { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .ap-venues { grid-template-columns: 1fr; } .ap-venue { aspect-ratio: 4/3; } }
</style>
