---
// Latest posts from @dg_trainings via Instagram's official embed script.
// The script only loads when the block nears the screen, so it costs nothing on first paint.
// To update: replace the post IDs with the newest ones from instagram.com/dg_trainings (…/p/<ID>/).
import Icon from './Icon.astro';
import { CONTACT } from '../lib/site';
const posts = ['Dell0LvjQfN', 'DejEBWykp5r', 'DedsW7nkVfS'];
---
<div class="ig" data-ig>
  <div class="ig-head">
    <div>
      <span class="ig-k"><span class="ig-badge" aria-hidden="true"><Icon name="instagram" /></span> Latest on Instagram</span>
      <b>@dg_trainings</b>
    </div>
    <a class="btn btn--teal" href={CONTACT.instagram} target="_blank" rel="noopener">Follow on Instagram <Icon name="arrow" class="arr" /></a>
  </div>
  <div class="ig-row">
    {posts.map((id) => (
      <div class="ig-post">
        <blockquote class="instagram-media" data-instgrm-permalink={`https://www.instagram.com/p/${id}/`} data-instgrm-version="14">
          <a href={`https://www.instagram.com/p/${id}/`} target="_blank" rel="noopener">View this post on Instagram</a>
        </blockquote>
      </div>
    ))}
  </div>
</div>

<style>
  .ig { margin-top: clamp(48px, 6vw, 72px); padding-top: clamp(32px, 4vw, 44px); border-top: 1px solid rgba(255,255,255,.12); }
  .ig-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; margin-bottom: 26px; }
  .ig-k { display: inline-flex; align-items: center; gap: 10px; font-size: .74rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--teal); }
  .ig-badge { width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; color: #fff; background: linear-gradient(45deg, #f9ce34, #ee2a7b 50%, #6228d7); }
  .ig-badge :global(svg) { width: 18px; height: 18px; }
  .ig-head b { display: block; margin-top: 8px; font-family: var(--display); font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 600; color: #fff; }
  .ig-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: start; }
  .ig-post { min-height: 420px; border-radius: 16px; background: rgba(255,255,255,.04); }
  .ig-post :global(.instagram-media) { min-width: 0 !important; width: 100% !important; max-width: 100% !important; margin: 0 !important; border-radius: 16px !important; }
  .ig-post blockquote { margin: 0; padding: 24px; color: rgba(255,255,255,.7); }
  .ig-post blockquote a { color: var(--teal); }
  @media (max-width: 960px) {
    .ig-row { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(300px, 80%); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -18px; padding: 0 18px 8px; scroll-padding-inline: 18px; }
    .ig-row::-webkit-scrollbar { display: none; }
    .ig-post { scroll-snap-align: start; }
  }
</style>

<script>
  function loadIg() {
    const root = document.querySelector<HTMLElement>('[data-ig]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const go = () => {
      const w = window as any;
      if (w.instgrm) { w.instgrm.Embeds.process(); return; }
      const s = document.createElement('script');
      s.src = 'https://www.instagram.com/embed.js'; s.async = true;
      document.body.appendChild(s);
    };
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); go(); } }, { rootMargin: '600px 0px' });
    io.observe(root);
  }
  document.addEventListener('astro:page-load', loadIg);
</script>
