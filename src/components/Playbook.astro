---
// "The DG Playbook": a book whose pages turn automatically, one question per page.
// Autoplay pauses on hover/focus and has a pause button; reduced-motion visitors get a fade instead of a 3D turn.
import Icon from './Icon.astro';
import { bySlug, progUrl } from '../lib/site';

const pages = [
  { q: 'When was the last time your team was trained?', slug: 'life-work-culture-transformation' },
  { q: 'Is your team ready for the next stage of growth?', slug: 'management-training' },
  { q: 'Is your marketing team delivering results?', slug: 'marketing-mastery' },
  { q: 'Is your team keeping up with digital change?', slug: 'digital-shakti' },
  { q: 'Are your managers bringing out the best in their teams?', slug: 'leadership-training' },
  { q: 'Is your customer getting the experience your brand promises?', slug: 'business-technical-sales-expert' },
  { q: 'Your targets are set. Is your team delivering?', slug: 'telemarketing-training' },
].map((p) => ({ ...p, prog: bySlug(p.slug) }));
---
<section class="pb on-dark" aria-labelledby="pb-h" data-playbook>
  <div class="wrap pb-grid">
    <div class="pb-side">
      <span class="eyebrow">The DG Playbook</span>
      <h2 id="pb-h">Seven questions every <em>jewellery business</em> should ask.</h2>
      <div class="pb-counter" aria-hidden="true"><b class="pb-cur">01</b><span>/ {String(pages.length).padStart(2, '0')}</span></div>
      <div class="pb-progress" aria-hidden="true"><i></i></div>
      <div class="pb-controls">
        <button type="button" class="pb-btn pb-prev" aria-label="Previous question"><Icon name="arrow" class="flip" /></button>
        <button type="button" class="pb-btn pb-play" aria-label="Pause the playbook" aria-pressed="false">
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
        </button>
        <button type="button" class="pb-btn pb-next" aria-label="Next question"><Icon name="arrow" /></button>
      </div>
      <div class="pb-dots" role="tablist" aria-label="Choose a question">
        {pages.map((_, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Question ${i + 1}`} data-go={i}></button>)}
      </div>
    </div>

    <div class="pb-stage">
      <div class="pb-book">
        <span class="pb-edges" aria-hidden="true"></span>
        <span class="pb-ribbon" aria-hidden="true"></span>
        <div class="pb-pages" aria-live="polite">
          {pages.map((p, i) => (
            <article class:list={['pg', { on: i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'} data-i={i}>
              <span class="pg-n">Question {String(i + 1).padStart(2, '0')}</span>
              <p class="pg-q">{p.q}</p>
              <a class="pg-link" href={progUrl(p.prog)} tabindex={i === 0 ? 0 : -1}>How we help: <b>{p.prog.name}</b> <Icon name="arrow" /></a>
              <span class="pg-folio" aria-hidden="true">{i + 1}</span>
            </article>
          ))}
        </div>
      </div>
      <div class="pb-answer">
        <p><b>If not,</b> we will work with you and your team to bring about the change.</p>
        <div class="btns">
          <a href="/contact/" class="btn btn--teal">Talk to DG <Icon name="arrow" class="arr" /></a>
          <a href="/programs/" class="btn btn--ghost">See the programs</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pb { background: var(--grey-900); color: #fff; padding: clamp(48px, 5vw, 72px) 0; overflow: hidden; position: relative; }
  .pb::before { content: ""; position: absolute; left: -120px; bottom: -160px; width: 420px; height: 420px; background: var(--teal); opacity: .06; clip-path: polygon(0 0, 50% 0, 100% 50%, 50% 100%, 0 100%, 50% 50%); }
  .pb-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(36px, 6vw, 90px); align-items: center; position: relative; }
  .pb h2 { font-size: clamp(2rem, 3.6vw, 3rem); margin-bottom: 28px; }
  .pb-counter { font-family: var(--display); display: flex; align-items: baseline; gap: 8px; }
  .pb-counter b { font-size: 3.4rem; font-weight: 600; color: var(--teal); line-height: 1; font-variant-numeric: tabular-nums; }
  .pb-counter span { font-size: 1.3rem; color: rgba(255,255,255,.5); }
  .pb-progress { height: 3px; background: rgba(255,255,255,.12); border-radius: 3px; margin: 16px 0 22px; overflow: hidden; max-width: 320px; }
  .pb-progress i { display: block; height: 100%; width: 100%; background: var(--teal); transform-origin: left; transform: scaleX(0); }
  .pb-controls { display: flex; gap: 10px; margin-bottom: 18px; }
  .pb-btn { width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; transition: background .3s, color .3s, border-color .3s; }
  .pb-btn:hover { background: var(--teal); border-color: var(--teal); color: var(--grey-950); }
  .pb-btn :global(svg), .pb-btn svg { width: 18px; height: 18px; }
  .pb-play .i-play { display: none; }
  .pb-play[aria-pressed="true"] .i-play { display: block; }
  .pb-play[aria-pressed="true"] .i-pause { display: none; }
  .pb-dots { display: flex; gap: 8px; flex-wrap: wrap; }
  .pb-dots button { width: 26px; height: 26px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .pb-dots button::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,.3); transition: background .3s, transform .3s; }
  .pb-dots button[aria-selected="true"]::before { background: var(--teal); transform: scale(1.35); }

  /* the book */
  .pb-stage { display: grid; gap: 26px; }
  .pb-book { position: relative; perspective: 2000px; height: clamp(300px, 30vw, 360px); margin-right: 14px; }
  .pb-edges { position: absolute; inset: 10px -14px -12px 10px; border-radius: 6px 18px 18px 6px; background: repeating-linear-gradient(0deg, #e9e7e2 0 2px, #d8d5ce 2px 3px); box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); }
  .pb-ribbon { position: absolute; right: 54px; top: -10px; width: 22px; height: 70px; background: var(--teal); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%); z-index: 5; }
  .pb-pages { position: absolute; inset: 0; transform-style: preserve-3d; }
  .pg { position: absolute; inset: 0; display: flex; flex-direction: column; padding: clamp(28px, 3.4vw, 46px) clamp(28px, 4vw, 56px); background: linear-gradient(90deg, #ebe8e1 0, #fbfaf7 7%, #fbfaf7 100%); color: var(--ink); border-radius: 6px 18px 18px 6px; box-shadow: inset 6px 0 14px -6px rgba(0,0,0,.25); transform-origin: left center; backface-visibility: hidden; visibility: hidden; }
  .pg.on, .pg.under { visibility: visible; }
  .pg.on { z-index: 3; }
  .pg.under { z-index: 2; }
  .pg.turning { z-index: 4; visibility: visible; animation: pbturn .9s cubic-bezier(.55,.06,.3,1) forwards; }
  .pg.returning { z-index: 4; visibility: visible; animation: pbturn .9s cubic-bezier(.55,.06,.3,1) reverse forwards; }
  @keyframes pbturn {
    0% { transform: rotateY(0); filter: brightness(1); }
    100% { transform: rotateY(-115deg); filter: brightness(.7); }
  }
  .pg::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--teal); border-radius: 6px 0 0 6px; }
  .pg-n { font-size: .74rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--teal-ink); }
  .pg-q { font-family: var(--display); font-size: clamp(1.7rem, 3vw, 2.6rem); line-height: 1.18; font-weight: 600; margin: 14px 0 auto; color: var(--ink); text-wrap: balance; }
  .pg-link { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; color: var(--muted); margin-top: 20px; align-self: flex-start; }
  .pg-link b { color: var(--teal-ink); }
  .pg-link :global(svg) { width: 16px; height: 16px; color: var(--teal-ink); transition: transform .4s var(--ease); }
  .pg-link:hover :global(svg) { transform: translateX(4px); }
  .pg-folio { position: absolute; right: 26px; bottom: 18px; font-family: var(--display); font-style: italic; color: var(--grey-300); font-size: 1rem; }
  .pb-answer { display: flex; align-items: center; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,.12); padding-top: 22px; }
  .pb-answer p { margin: 0; font-family: var(--display); font-size: clamp(1.15rem, 1.8vw, 1.45rem); font-style: italic; color: rgba(255,255,255,.9); max-width: 460px; }
  .pb-answer b { color: var(--teal); font-style: normal; }
  @media (prefers-reduced-motion: reduce) {
    .pg.turning, .pg.returning { animation: pbfade .5s ease forwards; }
    .pg.returning { animation-direction: reverse; }
    @keyframes pbfade { to { opacity: 0; } }
  }
  @media (max-width: 960px) {
    .pb-grid { grid-template-columns: 1fr; }
    .pb h2 { margin-bottom: 18px; }
    .pb-side { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 0 18px; }
    .pb-side .eyebrow, .pb-side h2, .pb-progress, .pb-dots { grid-column: 1 / -1; }
    .pb-controls { margin: 0; justify-self: end; }
    .pb-progress { max-width: none; margin: 12px 0 14px; }
  }
  @media (max-width: 560px) {
    .pb-book { height: 300px; }
    .pb-counter b { font-size: 2.6rem; }
    .pb-answer .btns { width: 100%; }
  }
</style>

<script>
  const INTERVAL = 4500;

  function initPlaybook() {
    const root = document.querySelector<HTMLElement>('[data-playbook]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const pages = [...root.querySelectorAll<HTMLElement>('.pg')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.pb-dots button')];
    const cur = root.querySelector('.pb-cur')!;
    const bar = root.querySelector<HTMLElement>('.pb-progress i')!;
    const play = root.querySelector<HTMLButtonElement>('.pb-play')!;
    let i = 0, busy = false, paused = false, hover = false, timer = 0, started = 0, elapsed = 0;

    const show = (n: number) => {
      pages.forEach((p, k) => {
        p.setAttribute('aria-hidden', String(k !== n));
        p.querySelector('a')?.setAttribute('tabindex', k === n ? '0' : '-1');
      });
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === n)));
      cur.textContent = String(n + 1).padStart(2, '0');
    };

    // finish a turn on animationend — or after a timeout if the browser never fires it (background tab etc.)
    const done = (el: HTMLElement, fn: () => void) => {
      let finished = false;
      const end = () => { if (finished) return; finished = true; fn(); busy = false; };
      el.addEventListener('animationend', end, { once: true });
      setTimeout(end, 1000);
    };

    const go = (n: number) => {
      n = (n + pages.length) % pages.length;
      if (busy || n === i) return;
      busy = true;
      const from = pages[i], to = pages[n];
      const forward = n > i || (i === pages.length - 1 && n === 0);
      if (forward) {
        // current page turns away, revealing the next one underneath
        to.classList.add('under');
        from.classList.add('turning');
        done(from, () => {
          from.classList.remove('on', 'turning');
          to.classList.replace('under', 'on');
        });
      } else {
        // previous page turns back over the current one
        from.classList.replace('on', 'under');
        to.classList.add('returning');
        done(to, () => {
          to.classList.remove('returning');
          to.classList.add('on');
          from.classList.remove('under');
        });
      }
      i = n;
      show(i);
      restart();
    };

    // progress bar + autoplay timer (pauses on hover/focus or the pause button)
    const tick = () => {
      if (paused || hover || document.hidden) { started = performance.now() - elapsed; }
      else {
        elapsed = performance.now() - started;
        bar.style.transform = `scaleX(${Math.min(elapsed / INTERVAL, 1)})`;
        if (elapsed >= INTERVAL) go(i + 1);
      }
      timer = requestAnimationFrame(tick);
    };
    const restart = () => { elapsed = 0; started = performance.now(); bar.style.transform = 'scaleX(0)'; };

    root.querySelector('.pb-next')!.addEventListener('click', () => go(i + 1));
    root.querySelector('.pb-prev')!.addEventListener('click', () => go(i - 1));
    dots.forEach((d) => d.addEventListener('click', () => go(+d.dataset.go!)));
    play.addEventListener('click', () => {
      paused = !paused;
      play.setAttribute('aria-pressed', String(paused));
      play.setAttribute('aria-label', paused ? 'Play the playbook' : 'Pause the playbook');
    });
    const stage = root.querySelector('.pb-book')!;
    stage.addEventListener('mouseenter', () => (hover = true));
    stage.addEventListener('mouseleave', () => (hover = false));
    root.addEventListener('focusin', () => (hover = true));
    root.addEventListener('focusout', () => (hover = false));
    let x0 = 0;
    stage.addEventListener('touchstart', (e) => { x0 = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => { const dx = (e as TouchEvent).changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1); });

    restart();
    timer = requestAnimationFrame(tick);
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(timer), { once: true });
  }

  document.addEventListener('astro:page-load', initPlaybook);
</script>
