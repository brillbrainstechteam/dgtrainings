---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import Venn from '../components/diagrams/Venn.astro';
import Timeline from '../components/diagrams/Timeline.astro';
import { TRAINER as T } from '../lib/site';
import { photo } from '../lib/photos';

const expertise = [
  { title: 'Business', items: ['In business since 2000', 'Brand & management consultant', 'Marketing and sales expert'] },
  { title: 'People', items: ['Training teams since 2011', '35,000+ professionals trained', 'Builder of work culture'] },
  { title: 'Jewellery', items: ['Dedicated to jewellers', 'Retail · wholesale · manufacturing', '100+ entrepreneurs'] },
];
const career = [
  { tag: 'Since 2000', icon: 'store', title: 'Inside businesses', text: 'Brand consultant, management consultant, marketer and natural copywriter.' },
  { tag: 'Since 2011', icon: 'users', title: 'Into training', text: 'One mission: helping people and teams perform at their very best.' },
  { tag: 'Focus', icon: 'sparkle', title: 'Focused on jewellery', text: 'DG dedicated his training work to jewellers across retail, wholesale and manufacturing.' },
  { tag: 'Today', icon: 'globe', title: '35,000+ professionals', text: '100+ entrepreneurs partnered, across 20 cities and 3 countries.' },
];
const moments = ['safalta-sangam/01', 'shivam-jewels/05', 'safalta-sangam/03', 'shilpi/02', 'jg/04'].map(photo);
---
<Base title="About the Trainer — Dipen Ghatalia (DG)" description={T.bio[0]} active="about">
  <section class="phero phero--simple on-dark">
    <div class="phero-bg"><Image src={photo('safalta-sangam/05')} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="chev-deco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb" data-hero><a href="/">Home</a><span>/</span><span aria-current="page">About the Trainer</span></nav>
        <span class="eyebrow" data-hero>{T.heading}</span>
        <h1 data-split>Dipen Ghatalia <em>(DG)</em></h1>
        <p class="lead" data-hero>{T.title}</p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap ab">
      <div class="ab-photo">
        <div class="frame" data-img><Image src={photo('shivam-jewels/07')} alt="Dipen Ghatalia (DG) leading a training session" widths={[500, 800]} sizes="(max-width: 960px) 90vw, 460px" loading="eager" /></div>
        <span class="ab-badge"><b>35,000+</b>professionals trained</span>
      </div>
      <div class="ab-body">
        <span class="eyebrow">The trainer</span>
        <h2 class="ab-h" data-split>In business since <em>2000</em>.<br />Training teams since <em>2011</em>.</h2>
        <p class="lead" data-reveal>{T.bio[0]}</p>
        <ul class="ab-facts" role="list" data-stagger>
          <li><b>100+</b><span>entrepreneurs partnered</span></li>
          <li><b>20</b><span>cities across 3 countries</span></li>
          <li><b>3</b><span>sides of the trade — retail, wholesale, manufacturing</span></li>
        </ul>
        <div class="ab-roles" data-reveal>
          {['Brand consultant', 'Management consultant', 'Marketing & sales expert', 'Natural copywriter', 'Builder of work culture'].map((r) => <span>{r}</span>)}
        </div>
        <div class="ab-gift" data-reveal>
          <p>{T.bio[2]}</p>
          <blockquote>“{T.quote}”<cite>— Dipen Ghatalia</cite></blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark on-dark">
    <div class="wrap">
      <div class="head head--row">
        <div><span class="eyebrow">Expertise</span><h2 data-split>Experience from the counter, <em>not just the classroom</em></h2></div>
        <p class="lead" data-reveal>Business know-how, a gift for people, and deep roots in the jewellery industry — DG works where all three meet.</p>
      </div>
      <Venn sets={expertise} center="DG" centerSub="where they meet" />
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="head"><span class="eyebrow">The journey</span><h2 data-split>From business to <em>building teams</em></h2></div>
      <Timeline phases={career} />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="head head--row">
        <div><span class="eyebrow">On stage</span><h2 data-split>From community forums to <em>company floors</em></h2></div>
      </div>
      <Gallery photos={moments} alt="DG leading a session" layout="strip" />
      <div class="btns" style="margin-top:36px;justify-content:center" data-reveal>
        <a href="/contact/" class="btn">Invite DG to Train Your Team <Icon name="arrow" class="arr" /></a>
      </div>
    </div>
  </section>

  <CtaBand heading="Bring DG to your team." text="Share your goals and team size — we’ll suggest the right format, from a single workshop to a year-long journey." bg="safalta-sangam/02" compact />
</Base>

<style>
  .ab { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(36px, 6vw, 88px); align-items: start; }
  .ab-photo { position: sticky; top: 110px; }
  .ab-photo .frame { aspect-ratio: 4 / 5; border-radius: 28px; }
  .ab-badge { position: absolute; right: -18px; bottom: 28px; display: grid; gap: 2px; padding: 16px 20px; border-radius: 18px; background: var(--grey-900); color: rgba(255,255,255,.8); font-size: .8rem; box-shadow: var(--shadow-lg); }
  .ab-badge b { font-family: var(--display); font-size: 1.9rem; color: var(--teal); line-height: 1; }
  .ab-h { font-size: clamp(1.9rem, 3.2vw, 2.7rem); line-height: 1.15; margin: 10px 0 18px; }
  .ab-facts { list-style: none; margin: 26px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ab-facts li { padding: 16px; border-radius: 18px; background: var(--grey-50); border: 1px solid var(--grey-100); }
  .ab-facts b { display: block; font-family: var(--display); font-size: 1.8rem; color: var(--teal-ink); line-height: 1; margin-bottom: 6px; }
  .ab-facts span { font-size: .84rem; color: var(--muted); line-height: 1.4; }
  .ab-roles { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .ab-roles span { font-size: .82rem; font-weight: 700; padding: 8px 14px; border-radius: 999px; background: var(--teal-50); color: var(--teal-ink); border: 1px solid var(--teal-100); }
  .ab-gift { margin-top: 28px; padding: 26px 28px; border-radius: 24px; color: #fff; background: radial-gradient(ellipse 80% 90% at 100% 0%, rgba(85,214,201,.28), transparent 60%), linear-gradient(150deg, #23282a, #12302c); }
  .ab-gift p { margin: 0 0 16px; color: rgba(255,255,255,.85); font-size: 1rem; }
  .ab-gift blockquote { margin: 0; font-family: var(--display); font-style: italic; font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.35; color: #fff; }
  .ab-gift cite { display: block; margin-top: 10px; font-family: var(--sans); font-style: normal; font-size: .8rem; font-weight: 700; color: var(--teal); }
  @media (max-width: 960px) { .ab { grid-template-columns: 1fr; } .ab-photo { position: relative; top: 0; max-width: 460px; } .ab-badge { right: 12px; } }
  @media (max-width: 560px) { .ab-facts { grid-template-columns: 1fr; } }
</style>
