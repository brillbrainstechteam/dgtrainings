---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { CONTACT, PROGRAMS, HOME as H, tel, wa, rich } from '../lib/site';
import { photo } from '../lib/photos';
---
<Base title="Contact — Plan Training for Your Team" description="Tell us about your business and the results you want. We’ll recommend the right program — or build one for you." active="contact">
  <section class="phero phero--simple on-dark">
    <div class="phero-bg"><Image src={photo('paras-gold/03')} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="chev-deco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb" data-hero><a href="/">Home</a><span>/</span><span aria-current="page">Contact</span></nav>
        <span class="eyebrow" data-hero>Connect</span>
        <h1 data-split>Let’s plan training for <em>your team</em></h1>
        <p class="lead" data-hero>Tell us about your business and the results you want. We’ll recommend the right program — or build one for you.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap split" style="align-items:start">
      <div>
        <h2 data-split>Your team’s next level is <em>one call away</em></h2>
        <ul class="contact-list contact-list--light" data-stagger>
          <li><a href={tel(CONTACT.phone_training)}><span class="ico"><Icon name="phone" /></span><span><small>Training appointments</small>{CONTACT.phone_training}</span></a></li>
          <li><a href={tel(CONTACT.phone_ops)}><span class="ico"><Icon name="phone" /></span><span><small>Operations</small>{CONTACT.phone_ops}</span></a></li>
          <li><a href={`mailto:${CONTACT.email}`}><span class="ico"><Icon name="mail" /></span><span><small>Email</small>{CONTACT.email}</span></a></li>
          <li><a href={`mailto:${CONTACT.email_bb}`}><span class="ico"><Icon name="mail" /></span><span><small>BrillBrains</small>{CONTACT.email_bb}</span></a></li>
          <li><a href={wa()} target="_blank" rel="noopener"><span class="ico"><Icon name="whatsapp" /></span><span><small>WhatsApp</small>Chat with us</span></a></li>
          <li><span class="row"><span class="ico"><Icon name="pin" /></span><span><small>Address</small><span set:html={rich(CONTACT.address)} /></span></span></li>
        </ul>
      </div>

      <form class="form" id="plan" novalidate data-email={CONTACT.email} data-wa={CONTACT.whatsapp} data-reveal>
        <div class="row2">
          <label>Full name *<input name="name" autocomplete="name" required placeholder="Your name" /></label>
          <label>Business name<input name="business" autocomplete="organization" placeholder="Jewellery brand / company" /></label>
        </div>
        <div class="row2">
          <label>Phone / WhatsApp *<input name="phone" type="tel" autocomplete="tel" required placeholder="+91" inputmode="tel" /></label>
          <label>Email<input name="email" type="email" autocomplete="email" placeholder="you@company.com" /></label>
        </div>
        <label>Program of interest
          <select name="program">
            <option value="">Not sure — recommend one</option>
            {PROGRAMS.map((p) => <option value={p.slug}>{p.name}</option>)}
          </select>
        </label>
        <label>Team size &amp; goals<textarea name="goals" placeholder="How many people, which roles, and what you want to improve"></textarea></label>
        <p class="err" role="alert" hidden>Please add your name and phone number so we can reach you.</p>
        <button class="btn" type="submit" data-via="wa"><Icon name="whatsapp" /> Send on WhatsApp</button>
        <button class="btn btn--outline" type="submit" data-via="mail" style="margin-top:10px"><Icon name="mail" /> Send by email</button>
        <p class="sent" role="status" hidden></p>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
        <p class="fine">WhatsApp opens a chat with your details filled in. Email sends your enquiry straight to {CONTACT.email}. See our <a href="/privacy-policy/">Privacy Policy</a>.</p>
      </form>
    </div>
  </section>

  <section class="section section--white" id="faq">
    <div class="wrap">
      <div class="head faq-head">
        <span class="eyebrow">FAQs</span>
        <h2 data-split>Questions, <em>answered</em></h2>
        <p class="lead" data-reveal>Quick answers before you call. Anything else, <a href={wa()} target="_blank" rel="noopener">ask us on WhatsApp</a>.</p>
      </div>
      <Faq items={H.faqs} />
    </div>
  </section>
</Base>
<style>
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .sent { margin: 14px 0 0; padding: 12px 14px; border-radius: 12px; font-size: .9rem; font-weight: 600; }
  .sent.ok { background: var(--teal-50); color: var(--teal-ink); }
  .sent.bad { background: #FEF3F2; color: #B42318; }
  .sent a, .form .fine a { color: inherit; text-decoration: underline; }
  .faq-head h2 { margin-bottom: 12px; }
  .faq-head .lead { margin: 0; }
  .faq-head .lead a { color: var(--teal-ink); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .contact-list--light { margin-top: 28px; }
  .contact-list--light a:hover { background: #fff; }
  .contact-list--light .ico { background: var(--grey-900); color: var(--teal); }
</style>
