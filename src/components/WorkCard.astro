---
// Gallery card: cover photo that cross-fades to a second shot on hover, photo count, short blurb.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { type Work, workUrl, rich } from '../lib/site';
import { album } from '../lib/photos';
interface Props { w: Work }
const { w } = Astro.props;
const pics = album(w.key);
---
<a href={workUrl(w)} class="gcard">
  <div class="g-img">
    <Image src={pics[0]} alt={`${w.client} training session`} widths={[480, 800]} sizes="(max-width: 640px) 92vw, (max-width: 1080px) 46vw, 400px" />
    {pics[1] && <Image src={pics[1]} alt="" class="g-alt" widths={[480, 800]} sizes="(max-width: 640px) 92vw, (max-width: 1080px) 46vw, 400px" />}
    <span class="g-count">{pics.length} photos</span>
  </div>
  <div class="g-body">
    <span class="g-meta">{[w.kind, w.where].filter(Boolean).join(' · ')}</span>
    <h3>{w.client}</h3>
    <p set:html={rich(w.program ?? w.blurb)} />
    <span class="g-link">View gallery <Icon name="arrow" /></span>
  </div>
</a>

<style>
  .gcard { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1px solid var(--grey-200); border-radius: var(--radius-lg); overflow: hidden; color: var(--text); transition: transform .5s var(--ease), box-shadow .5s var(--ease), border-color .5s; }
  .gcard:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .g-img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--grey-100); }
  .g-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), opacity .7s ease; }
  .g-img :global(.g-alt) { opacity: 0; }
  .gcard:hover .g-img :global(img) { transform: scale(1.05); }
  .gcard:hover .g-img :global(.g-alt) { opacity: 1; }
  .g-count { position: absolute; z-index: 1; right: 14px; bottom: 14px; font-size: .74rem; font-weight: 800; letter-spacing: .06em; padding: 6px 12px; border-radius: 999px; background: rgba(25,26,28,.72); color: #fff; backdrop-filter: blur(6px); }
  .g-body { display: flex; flex-direction: column; flex: 1; padding: 22px 24px 24px; }
  .g-meta { font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--teal-ink); font-weight: 800; }
  .g-body h3 { font-size: 1.5rem; margin: 8px 0 8px; color: var(--ink); }
  .g-body p { margin: 0 0 18px; font-size: .93rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .g-link { margin-top: auto; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: .9rem; color: var(--teal-ink); }
  .g-link :global(svg) { width: 16px; height: 16px; transition: transform .4s var(--ease); }
  .gcard:hover .g-link :global(svg) { transform: translateX(4px); }
  :global(.on-dark) .gcard { background: var(--grey-900); border-color: rgba(255,255,255,.08); }
  :global(.on-dark) .gcard h3 { color: #fff; }
  :global(.on-dark) .gcard p { color: rgba(255,255,255,.7); }
  :global(.on-dark) .g-meta, :global(.on-dark) .g-link { color: var(--teal); }
</style>
