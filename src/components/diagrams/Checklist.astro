---
// Welcome-kit checklist: an ID-badge card beside a ticked list.
interface Props { badge: string; badgeSub: string; items: { title: string; text: string }[] }
const { badge, badgeSub, items } = Astro.props;
---
<div class="ck">
  <div class="ck-badge" data-reveal>
    <span class="ck-clip" aria-hidden="true"></span>
    <span class="ck-logo">DG<small>TRAININGS</small></span>
    <span class="ck-photo" aria-hidden="true"></span>
    <b>{badge}</b>
    <span class="ck-sub">{badgeSub}</span>
    <span class="ck-strip">Day 01</span>
  </div>
  <ol class="ck-list" role="list" data-stagger>
    {items.map((it) => (
      <li><span class="ck-tick" aria-hidden="true"></span><div><b>{it.title}</b><p>{it.text}</p></div></li>
    ))}
  </ol>
</div>

<style>
  .ck { display: grid; grid-template-columns: 300px 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; max-width: 1000px; margin: 0 auto; }
  .ck-badge { position: relative; background: #fff; border-radius: 20px; padding: 46px 26px 0; text-align: center; box-shadow: var(--shadow-lg); border: 1px solid var(--grey-200); overflow: hidden; rotate: -3deg; transition: rotate .6s var(--ease); }
  .ck-badge:hover { rotate: 0deg; }
  .ck-clip { position: absolute; top: 14px; left: 50%; translate: -50% 0; width: 60px; height: 10px; border-radius: 6px; background: var(--grey-200); }
  .ck-logo { display: block; font-family: var(--display); font-size: 1.6rem; font-weight: 600; color: var(--ink); line-height: 1; }
  .ck-logo small { display: block; font-size: .7rem; letter-spacing: .2em; color: var(--teal-ink); margin-top: 2px; }
  .ck-photo { display: block; width: 96px; height: 96px; margin: 20px auto 16px; border-radius: 50%; background: radial-gradient(circle at 50% 38%, var(--grey-300) 0 22%, transparent 23%), radial-gradient(ellipse at 50% 105%, var(--grey-300) 0 45%, transparent 46%), var(--grey-100); }
  .ck-badge b { display: block; font-family: var(--display); font-size: 1.4rem; color: var(--ink); }
  .ck-sub { display: block; font-size: .85rem; color: var(--muted); margin: 2px 0 24px; }
  .ck-strip { display: block; margin: 0 -26px; background: var(--grey-900); color: var(--teal); font-weight: 800; letter-spacing: .2em; text-transform: uppercase; font-size: .8rem; padding: 12px; }
  .ck-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ck-list li { display: flex; gap: 16px; align-items: flex-start; background: #fff; border: 1px solid var(--grey-200); border-radius: 14px; padding: 16px 18px; transition: border-color .3s, transform .4s var(--ease); }
  .ck-list li:hover { border-color: var(--teal); transform: translateX(4px); }
  .ck-tick { flex: none; width: 30px; height: 30px; border-radius: 8px; background: var(--teal); position: relative; }
  .ck-tick::after { content: ""; position: absolute; left: 10px; top: 5px; width: 8px; height: 14px; border-right: 3px solid var(--grey-950); border-bottom: 3px solid var(--grey-950); rotate: 45deg; }
  .ck-list b { display: block; color: var(--ink); }
  .ck-list p { margin: 2px 0 0; font-size: .9rem; color: var(--muted); }
  @media (max-width: 760px) { .ck { grid-template-columns: 1fr; } .ck-badge { max-width: 280px; margin: 0 auto; } }
</style>
