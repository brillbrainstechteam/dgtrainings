---
// Curriculum as a module explorer: numbered module list on the left, the selected module's topics on the right.
// Without JavaScript every module shows in turn.
import { rich } from '../lib/site';
interface Props { modules: [string, string | string[]][]; id: string }
const { modules, id } = Astro.props;
const topics = (b: string | string[]) => (Array.isArray(b) ? b : [b]);
---
<div class="mx" data-mx>
  <div class="mx-list" role="tablist" aria-label="Modules">
    {modules.map(([t, b], i) => (
      <button type="button" role="tab" id={`${id}-t${i}`} aria-controls={`${id}-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="mx-n">{String(i + 1).padStart(2, '0')}</span>
        <span class="mx-t">{t}</span>
        <span class="mx-c">{topics(b).length}</span>
      </button>
    ))}
  </div>
  <div class="mx-panels">
    {modules.map(([t, b], i) => (
      <section class="mx-panel" role="tabpanel" id={`${id}-p${i}`} aria-labelledby={`${id}-t${i}`} data-on={i === 0 ? '' : undefined}>
        <div class="mx-head">
          <span class="mx-big" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div><small>Module {i + 1} of {modules.length}</small><h3>{t}</h3></div>
        </div>
        {Array.isArray(b)
          ? <ul class="mx-topics">{b.map((x) => <li set:html={rich(x)} />)}</ul>
          : <p class="mx-text" set:html={rich(b)} />}
      </section>
    ))}
  </div>
</div>

<style>
  .mx { display: grid; grid-template-columns: minmax(260px, 360px) 1fr; gap: 22px; align-items: start; }
  .mx-list { display: grid; gap: 6px; position: sticky; top: 140px; }
  .mx-list button { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; padding: 12px 14px; border-radius: 14px; border: 1px solid transparent; background: transparent; cursor: pointer; font: inherit; color: var(--muted); transition: background .3s, color .3s, border-color .3s, transform .4s var(--ease); }
  .mx-list button:hover { background: #fff; border-color: var(--grey-200); color: var(--ink); }
  .mx-list button[aria-selected="true"] { background: var(--grey-900); color: #fff; transform: translateX(6px); box-shadow: 0 16px 30px -18px rgba(25,26,28,.7); }
  .mx-n { font-family: var(--display); font-size: 1.1rem; font-weight: 600; color: var(--teal-ink); width: 28px; flex: none; }
  .mx-list button[aria-selected="true"] .mx-n { color: var(--teal); }
  .mx-t { font-weight: 700; font-size: .92rem; line-height: 1.3; margin-right: auto; }
  .mx-c { flex: none; min-width: 26px; height: 26px; padding: 0 7px; border-radius: 999px; display: grid; place-items: center; font-size: .72rem; font-weight: 800; background: var(--grey-100); color: var(--grey-500); }
  .mx-list button[aria-selected="true"] .mx-c { background: var(--teal); color: var(--grey-950); }
  .mx-panels { position: relative; }
  .mx-panel { position: relative; overflow: hidden; background: #fff; border: 1px solid var(--grey-200); border-radius: 26px; padding: clamp(26px, 3vw, 40px); box-shadow: 0 30px 60px -40px rgba(25,26,28,.45); }
  :global(.js) .mx-panel:not([data-on]) { display: none; }
  :global(.js) .mx-panel[data-on] { animation: mxin .55s var(--ease) both; }
  .mx-panel + .mx-panel { margin-top: 16px; }
  :global(.js) .mx-panel + .mx-panel { margin-top: 0; }
  @keyframes mxin { from { opacity: 0; transform: translateY(14px); } }
  .mx-head { display: flex; align-items: center; gap: 18px; margin-bottom: 22px; }
  .mx-big { font-family: var(--display); font-size: 4.2rem; font-weight: 700; line-height: .9; color: transparent; -webkit-text-stroke: 1.5px var(--teal-600); flex: none; }
  .mx-head small { font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--teal-ink); }
  .mx-head h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); margin: 4px 0 0; }
  .mx-topics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .mx-topics li { position: relative; padding: 12px 14px 12px 40px; border-radius: 14px; background: var(--grey-50); border: 1px solid var(--grey-100); font-size: .92rem; line-height: 1.45; color: var(--text); }
  .mx-topics li::before { content: ""; position: absolute; left: 15px; top: 17px; width: 12px; height: 9px; background: var(--teal-600); clip-path: polygon(0 0, 50% 0, 100% 50%, 50% 100%, 0 100%, 50% 50%); }
  .mx-topics li :global(b) { color: var(--ink); }
  .mx-text { margin: 0; font-size: 1.02rem; color: var(--muted); }
  @media (max-width: 960px) {
    .mx { grid-template-columns: 1fr; }
    .mx-list { position: static; display: flex; overflow-x: auto; gap: 8px; padding-bottom: 6px; scrollbar-width: none; }
    .mx-list::-webkit-scrollbar { display: none; }
    .mx-list button { flex: none; width: auto; background: #fff; border-color: var(--grey-200); }
    .mx-list button[aria-selected="true"] { transform: none; }
    .mx-c { display: none; }
    .mx-topics { grid-template-columns: 1fr; }
  }
</style>

<script>
  function initMx() {
    document.documentElement.classList.add('js');
    document.querySelectorAll<HTMLElement>('[data-mx]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const show = (k: number, focus = false) => {
        tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === k)); t.tabIndex = j === k ? 0 : -1; });
        panels.forEach((p, j) => { if (j === k) p.setAttribute('data-on', ''); else p.removeAttribute('data-on'); });
        if (focus) tabs[k].focus();
        tabs[k].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      };
      tabs.forEach((t, k) => {
        t.addEventListener('click', () => show(k));
        t.addEventListener('keydown', (e) => {
          const d = ['ArrowDown', 'ArrowRight'].includes(e.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(e.key) ? -1 : 0;
          if (d) { e.preventDefault(); show((k + d + tabs.length) % tabs.length, true); }
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initMx);
</script>
