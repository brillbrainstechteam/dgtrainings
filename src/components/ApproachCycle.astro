---
// Circular process diagram for Discover → Design → Deliver → Sustain.
import Icon from './Icon.astro';
interface Props { steps: string[][]; center: string; sub: string }
const { steps, center, sub } = Astro.props;
const icons = ['search', 'pen', 'play', 'refresh'];
const areas = ['n', 'e', 's', 'w'];
const chips = ['Listen first', 'Built for you', 'Learn by doing', 'Make it stick'];
// four arcs on a circle (r=150, centre 200,200) leaving gaps at the 4 nodes, each ending in an arrow
const R = 150, C = 200, gap = 16;
const pt = (deg: number) => [C + R * Math.cos((deg * Math.PI) / 180), C + R * Math.sin((deg * Math.PI) / 180)].map((v) => v.toFixed(1));
const arcs = [-90, 0, 90, 180].map((a) => {
  const [x1, y1] = pt(a + gap), [x2, y2] = pt(a + 90 - gap);
  return `M${x1} ${y1} A${R} ${R} 0 0 1 ${x2} ${y2}`;
});
const nodes = [-90, 0, 90, 180].map(pt);
---
<div class="cycle" data-cycle>
  <div class="ring" aria-hidden="true">
    <svg viewBox="0 0 400 400">
      <defs>
        <marker id="cy-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10 3 5z" fill="#24B2A3" />
        </marker>
      </defs>
      <circle cx="200" cy="200" r="150" class="ring-bg" />
      {arcs.map((d) => <path d={d} class="ring-arc" marker-end="url(#cy-arrow)" />)}
      {nodes.map(([x, y], i) => <g class="ring-node"><circle cx={x} cy={y} r="24" /><text x={x} y={+y + 7}>{i + 1}</text></g>)}
    </svg>
    <div class="ring-center">
      <strong>{center}</strong>
      <span>{sub}</span>
    </div>
  </div>
  <ol role="list">
    {steps.map(([t, d], i) => (
      <li class={`cy-step a-${areas[i]}`}>
        <span class="cy-wm" aria-hidden="true">0{i + 1}</span>
        <div class="cy-top">
          <span class="cy-ico"><Icon name={icons[i]} /></span>
          <span class="cy-chip">Stage 0{i + 1} · {chips[i]}</span>
        </div>
        <h3>{t}</h3>
        <p>{d}</p>
        <span class="cy-bar" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
</div>

<style>
  .cycle { position: relative; }
  .cycle ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 420px 1fr; grid-template-rows: auto 1fr auto; grid-template-areas: ". n ." "w c e" ". s ."; gap: 18px 36px; align-items: center; }
  .ring { position: absolute; left: 50%; top: 50%; width: 420px; height: 420px; transform: translate(-50%, -50%); }
  .ring svg { width: 100%; height: 100%; overflow: visible; }
  .ring-bg { fill: none; stroke: var(--grey-200); stroke-width: 1.5; stroke-dasharray: 3 7; }
  .ring-arc { fill: none; stroke: var(--teal-600); stroke-width: 3; stroke-linecap: round; }
  .ring-node circle { fill: var(--grey-900); stroke: #fff; stroke-width: 5; }
  .ring-node text { fill: var(--teal); font-family: var(--display); font-size: 20px; font-weight: 600; text-anchor: middle; }
  .ring-center { position: absolute; inset: 27%; border-radius: 50%; background: var(--grey-900); color: #fff; display: grid; place-content: center; text-align: center; padding: 18px; box-shadow: 0 0 0 12px var(--teal-50), var(--shadow-lg); }
  .ring-center strong { font-family: var(--display); font-size: 1.45rem; line-height: 1.15; font-weight: 600; color: var(--teal); }
  .ring-center span { font-size: .78rem; color: rgba(255,255,255,.75); margin-top: 8px; line-height: 1.4; }
  .cy-step { position: relative; isolation: isolate; display: flex; flex-direction: column; gap: 10px; max-width: 380px; padding: 24px 26px 28px; border-radius: 24px; overflow: hidden;
    background: linear-gradient(155deg, #ffffff 0%, #f3faf9 100%); border: 1px solid var(--grey-200); box-shadow: 0 18px 40px -26px rgba(25,26,28,.35);
    transition: transform .6s var(--ease), box-shadow .6s var(--ease), border-color .4s, background .5s, color .4s; }
  .cy-step::before { content: ""; position: absolute; z-index: -1; inset: 0; opacity: 0; background: radial-gradient(120% 90% at 100% 0%, rgba(85,214,201,.35), transparent 55%), linear-gradient(150deg, #262b2d 0%, #15302c 100%); transition: opacity .6s ease; }
  .cy-step:hover { transform: translateY(-6px); border-color: var(--teal); }
  .cy-wm { position: absolute; right: 14px; top: -14px; z-index: -1; font-family: var(--display); font-size: 6.4rem; font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px rgba(36,178,163,.28); transition: -webkit-text-stroke-color .5s, transform .8s var(--ease); }
  .cy-top { display: flex; align-items: center; gap: 12px; }
  .cy-ico { flex: none; width: 48px; height: 48px; border-radius: 16px; display: grid; place-items: center; color: #fff; background: linear-gradient(140deg, var(--teal) 0%, var(--teal-ink) 100%); box-shadow: 0 10px 20px -10px rgba(15,113,104,.8); transition: transform .6s var(--ease); }
  .cy-ico :global(svg) { width: 22px; height: 22px; }
  .cy-chip { font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--teal-ink); background: var(--teal-50); padding: 6px 10px; border-radius: 999px; transition: background .4s, color .4s; }
  .cy-step h3 { font-size: 1.55rem; margin: 6px 0 0; transition: color .4s; }
  .cy-step p { font-size: .93rem; color: var(--muted); margin: 0; transition: color .4s; }
  .cy-bar { position: absolute; left: 26px; right: 26px; bottom: 14px; height: 3px; border-radius: 3px; background: rgba(36,178,163,.15); overflow: hidden; opacity: 0; transition: opacity .4s; }
  .cy-bar::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, var(--teal), #a6f0e8); transform-origin: left; transform: scaleX(0); }
  /* active stage: dark glass card, synced with the ring */
  .cycle .cy-step.is-active { border-color: transparent; transform: translateY(-6px) scale(1.02); box-shadow: 0 30px 60px -26px rgba(15,113,104,.75); }
  .cy-step.is-active::before { opacity: 1; }
  .cy-step.is-active h3 { color: #fff; }
  .cy-step.is-active p { color: rgba(255,255,255,.78); }
  .cy-step.is-active .cy-chip { background: rgba(85,214,201,.16); color: var(--teal); }
  .cy-step.is-active .cy-wm { -webkit-text-stroke-color: rgba(85,214,201,.45); transform: translateY(6px); }
  .cy-step.is-active .cy-ico { transform: rotate(-8deg) scale(1.06); }
  .cy-step.is-active .cy-bar { opacity: 1; }
  .cy-step.is-active .cy-bar::after { animation: cyfill 2.6s linear forwards; }
  @keyframes cyfill { to { transform: scaleX(1); } }
  .a-n { grid-area: n; justify-self: center; } .a-s { grid-area: s; justify-self: center; }
  .a-e { grid-area: e; justify-self: start; } .a-w { grid-area: w; justify-self: end; }
  @media (prefers-reduced-motion: reduce) { .cy-step.is-active .cy-bar::after { animation: none; transform: scaleX(1); } }
  /* leave the centre cell for the ring */
  .cycle ol::before { content: ""; grid-area: c; height: 420px; }
  @media (max-width: 1100px) {
    .cycle ol { grid-template-columns: 1fr; grid-template-areas: none; grid-template-rows: none; gap: 14px; }
    .cycle ol::before { display: none; }
    .ring { position: relative; left: auto; top: auto; transform: none; width: min(320px, 80vw); height: min(320px, 80vw); margin: 0 auto 28px; }
    .cy-step { grid-area: auto !important; max-width: none; justify-self: stretch !important; }
  }
</style>
