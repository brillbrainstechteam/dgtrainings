---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Bento from '../../components/diagrams/Bento.astro';
import { WORK, CLIENTS, workUrl } from '../../lib/site';
import { photo } from '../../lib/photos';

const segments = [
  { label: 'Retail showrooms', text: 'Suraj Bhan · Saheli Aurum · D.P. Jewellers', icon: 'store', img: photo('suraj-bhan/01'), href: '/work/suraj-bhan/' },
  { label: 'Manufacturers', text: 'Unique · Shivam Jewels', icon: 'factory', img: photo('unique-factory/02'), href: '/work/unique-factory/' },
  { label: 'Exporters', text: 'SRK, Hong Kong', icon: 'globe', img: photo('srk-hongkong/02'), href: '/work/srk-hongkong/' },
  { label: 'Business forums', text: 'Safalta Sangam', icon: 'users', img: photo('safalta-sangam/02'), href: '/work/safalta-sangam/' },
  { label: 'Retail groups', text: 'Geetanjali · Paras Gold', icon: 'boxes', img: photo('paras-gold/02'), href: '/work/paras-gold/' },
  { label: 'Brands & teams', text: 'Shine Shilpi · Jewel Goldi', icon: 'sparkle', img: photo('shilpi/01'), href: '/work/shilpi/' },
];
const withGallery = new Set(WORK.map((w) => w.client));
const others = CLIENTS.filter((c) => !withGallery.has(c.name)).map((c) => c.name);
---
<Base title="Our Work — Client Galleries" description="Photo galleries from DG Trainings sessions with jewellery retailers, manufacturers, exporters and business forums." active="work">
  <section class="phero phero--simple on-dark">
    <div class="phero-bg"><Image src={photo('dp/03')} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="chev-deco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb" data-hero><a href="/">Home</a><span>/</span><span aria-current="page">Our Work</span></nav>
        <span class="eyebrow" data-hero>Our work</span>
        <h1 data-split>{WORK.length} client galleries. <em>One standard of excellence.</em></h1>
        <p class="lead" data-hero>From century-old family names to fast-growing modern brands — here’s a look inside the training room.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="head head--row">
        <div><span class="eyebrow">Where we train</span><h2 data-split>Every corner of the <em>jewellery business</em></h2></div>
        <p class="lead" data-reveal>The same practical approach, adapted to showroom floors, factory units, export desks and business communities.</p>
      </div>
      <Bento tiles={segments} />
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Galleries</span><h2 data-split>Open any <em>engagement</em></h2></div>
      <div class="wgrid" data-stagger>{WORK.map((w, i) => <WorkCard w={w} video={i === 0} />)}</div>
      {others.length > 0 && (
        <p class="others" data-reveal><b>Also featured:</b> {others.join(' · ')} <mark class="tbc">galleries to be added</mark></p>
      )}
    </div>
  </section>

  <CtaBand heading="Your team could be next." text="Tell us about your business, and we’ll design a program around your products, customers and targets." bg="suraj-bhan/02" compact />
</Base>
<style>
  .others { margin: 36px 0 0; padding: 22px 26px; border: 1px dashed var(--grey-300); border-radius: var(--radius); color: var(--muted); font-size: .95rem; }
  .others b { color: var(--ink); }
</style>
