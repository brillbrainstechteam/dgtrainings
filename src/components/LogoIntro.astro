---
// Opening logo animation: the DG mark builds itself, then the curtain lifts to reveal the page.
// Shown once per browser session, never with reduced motion or ?static, and tap/click skips it.
import logo from '../assets/brand/dg-logo.svg?raw';
---
<script is:inline>
  (function () {
    try {
      var skip = matchMedia('(prefers-reduced-motion: reduce)').matches || location.search.indexOf('static') > -1 || sessionStorage.getItem('dg-intro');
      if (!skip) { document.documentElement.classList.add('intro'); sessionStorage.setItem('dg-intro', '1'); }
    } catch (e) {}
  })();
</script>
<div class="intro-veil" aria-hidden="true">
  <div class="intro-logo" set:html={logo} />
</div>
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains('intro')) return;
    var end = function () { root.classList.add('intro-out'); setTimeout(function () { root.classList.remove('intro', 'intro-out'); }, 700); };
    var t = setTimeout(end, 2300);
    document.querySelector('.intro-veil').addEventListener('click', function () { clearTimeout(t); end(); });
  })();
</script>

<style is:global>
  .intro-veil { display: none; }
  .intro .intro-veil { display: grid; place-items: center; position: fixed; inset: 0; z-index: 200; cursor: pointer;
    background: radial-gradient(ellipse 70% 60% at 50% 45%, #ffffff 0%, #f3faf9 60%, #e4f6f3 100%); }
  .intro body { overflow: hidden; }
  .intro-out .intro-veil { animation: veilUp .7s cubic-bezier(.76,0,.24,1) forwards; }
  .intro-logo { width: min(440px, 74vw); }
  .intro-logo svg { display: block; width: 100%; height: auto; overflow: visible; }
  /* build sequence */
  .intro .lg-d { animation: lgD .7s cubic-bezier(.22,1,.36,1) .1s both; }
  .intro .lg-tri { animation: lgTri .6s cubic-bezier(.34,1.56,.64,1) .55s both; }
  .intro .lg-g { animation: lgG .7s cubic-bezier(.22,1,.36,1) .35s both; }
  .intro .lg-word use { animation: lgFade .45s ease both; animation-delay: calc(.8s + var(--i) * .05s); }
  .intro .lg-word { animation: lgRise .8s cubic-bezier(.22,1,.36,1) .75s both; }
  .intro .lg-tag { animation: lgTag .8s ease 1.3s both; }
  @keyframes lgD { from { clip-path: inset(100% 0 0 0); opacity: 0; } to { clip-path: inset(0 0 0 0); opacity: 1; } }
  @keyframes lgTri { from { opacity: 0; translate: 0 -60px; } to { opacity: 1; translate: 0 0; } }
  @keyframes lgG { from { opacity: 0; translate: 60px 0; } to { opacity: 1; translate: 0 0; } }
  @keyframes lgFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lgRise { from { translate: 0 30px; } to { translate: 0 0; } }
  @keyframes lgTag { from { opacity: 0; letter-spacing: .3em; } to { opacity: 1; } }
  @keyframes veilUp { to { clip-path: inset(0 0 100% 0); } }
  .intro-veil { clip-path: inset(0 0 0 0); }
</style>
