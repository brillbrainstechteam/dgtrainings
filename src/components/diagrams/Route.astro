---
// Route map: a winding dashed road with numbered stops, from a start point to a destination.
interface Props { start: string; end: string; stops: { title: string; text: string }[] }
const { start, end, stops } = Astro.props;
// stop positions along the road (viewBox 1000 x 300)
const pts = [[150, 210], [330, 90], [500, 200], [670, 90], [850, 200]].slice(0, stops.length);
const d = `M20 150 C 80 150, 100 210, 150 210 S 270 90, 330 90 S 440 200, 500 200 S 610 90, 670 90 S 790 200, 850 200 S 940 150, 980 150`;
---
<div class="route" data-route>
  <div class="rt-map">
    <svg viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
      <path d={d} class="rt-road" />
      <path d={d} class="rt-dash" />
    </svg>
    <span class="rt-end rt-end--a">{start}</span>
    <span class="rt-end rt-end--b">{end}</span>
    {pts.map(([x, y], i) => (
      <div class:list={['rt-stop', y < 150 ? 'top' : 'bot']} style={`left:${x / 10}%;top:${(y / 300) * 100}%`}>
        <span class="rt-pin">{i + 1}</span>
        <div class="rt-lbl"><b>{stops[i].title}</b><small>{stops[i].text}</small></div>
      </div>
    ))}
  </div>
</div>

<style>
  .rt-map { position: relative; height: 360px; margin: 40px 0; }
  .rt-map svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .rt-road { fill: none; stroke: var(--grey-900); stroke-width: 26; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .rt-dash { fill: none; stroke: var(--teal); stroke-width: 3; stroke-dasharray: 14 12; stroke-linecap: round; vector-effect: non-scaling-stroke; animation: rtmove 1.6s linear infinite; }
  @keyframes rtmove { to { stroke-dashoffset: -26; } }
  .rt-end { position: absolute; top: 50%; translate: 0 -50%; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; background: var(--teal); color: var(--grey-950); padding: 8px 12px; border-radius: 8px; }
  .rt-end--a { left: -6px; translate: -40% -150%; background: var(--grey-200); color: var(--ink); }
  .rt-end--b { right: -6px; translate: 40% -150%; }
  .rt-stop { position: absolute; translate: -50% -50%; display: flex; flex-direction: column; align-items: center; width: 200px; }
  .rt-pin { width: 44px; height: 44px; border-radius: 50% 50% 50% 0; rotate: -45deg; background: var(--teal); display: grid; place-items: center; box-shadow: 0 6px 14px rgba(0,0,0,.25); }
  .rt-pin { color: var(--grey-950); font-weight: 800; font-family: var(--display); font-size: 1.1rem; }
  .rt-lbl { text-align: center; background: #fff; border: 1px solid var(--grey-200); border-radius: 12px; padding: 10px 12px; box-shadow: var(--shadow); }
  .rt-lbl b { display: block; font-size: .95rem; color: var(--ink); }
  .rt-lbl small { display: block; font-size: .78rem; color: var(--muted); line-height: 1.35; margin-top: 2px; }
  .rt-stop.top { flex-direction: column-reverse; translate: -50% calc(-100% + 22px); }
  .rt-stop.top .rt-lbl { margin-bottom: 10px; }
  .rt-stop.bot { translate: -50% -22px; }
  .rt-stop.bot .rt-lbl { margin-top: 10px; }
  .rt-pin { line-height: 1; }
  @media (prefers-reduced-motion: reduce) { .rt-dash { animation: none; } }
  @media (max-width: 860px) {
    .rt-map { height: auto; margin: 0; display: grid; gap: 12px; padding-left: 30px; border-left: 4px dashed var(--teal-600); }
    .rt-map svg, .rt-end { display: none; }
    .rt-stop, .rt-stop.top, .rt-stop.bot { position: static; translate: none; width: auto; flex-direction: row; gap: 14px; }
    .rt-stop .rt-lbl { margin: 0 !important; text-align: left; flex: 1; }
    .rt-pin { flex: none; margin-left: -54px; }
  }
</style>
