---
// "The DG Playbook": a fanned deck of question cards. The top card sweeps away every few seconds
// and tucks in at the back, revealing the next question. Holds while hovered, has prev/next arrows,
// swipe on touch, and a gentle fade for reduced-motion visitors.
import Icon from './Icon.astro';
import { bySlug, progUrl } from '../lib/site';

// [[...]] marks the words to highlight in each question
const cards = [
  { q: 'When was the [[last time]] your team was trained?', slug: 'life-work-culture-transformation', icon: 'users' },
  { q: 'Do you need a [[training solution]] when a new employee joins?', slug: 'orientation-training', icon: 'sparkle' },
  { q: 'Do you have a [[marketing team]] for getting new customer leads?', slug: 'marketing-training', icon: 'target' },
  { q: 'Is your team [[digitally equipped]] in their day-to-day work?', slug: 'digital-shakti', icon: 'chat' },
  { q: 'Do you have an [[ownership and leadership]] culture in your organization?', slug: 'leadership-training', icon: 'chart' },
  { q: 'Is your team equipped with the best [[business knowledge]]?', slug: 'business-technical-sales-expert', icon: 'book' },
  { q: 'Do you need [[extraordinary results]] from every exhibition you participate in? Do you provide training before every exhibition?', slug: 'exhibitions-training', icon: 'globe' },
  { q: 'Your targets are set. Is your team [[delivering]] on every sales tour?', slug: 'sales-tour-training', icon: 'trend' },
  { q: 'Is your business ready for the [[next stage of growth]]?', slug: 'management-training', icon: 'heart' },
].map((c, i) => ({ ...c, prog: bySlug(c.slug), html: c.q.replace(/\[\[(.+?)\]\]/g, '<em>$1</em>'), theme: ['dark', 'teal', 'cream'][i % 3] }));
---
<section class="pb on-dark" aria-labelledby="pb-h" data-playbook>
  <span class="pb-blob pb-blob--a" aria-hidden="true"></span>
  <span class="pb-blob pb-blob--b" aria-hidden="true"></span>
  <div class="wrap pb-grid">
    <div class="pb-side">
      <span class="eyebrow">The DG Playbook</span>
      <h2 id="pb-h">Questions every <em>jewellery business</em> should ask.</h2>
      <p class="pb-intro">Be honest with each one. If an answer makes you pause, that’s where we start.</p>

      <div class="pb-controls">
        <button type="button" class="pb-btn pb-prev" aria-label="Previous question"><Icon name="arrow" class="flip" /></button>
        <button type="button" class="pb-btn pb-next" aria-label="Next question"><Icon name="arrow" /></button>
      </div>
    </div>

    <div class="pb-stage">
      <div class="pb-deck">
        {cards.map((c, i) => (
          <article class={`pb-card pb-card--${c.theme}`} data-pos={i < 3 ? i : 3} aria-hidden={i === 0 ? 'false' : 'true'}>
            <div class="pc-top">
              <span class="pc-tag">Question {String(i + 1).padStart(2, '0')}</span>
              <span class="pc-ic"><Icon name={c.icon} /></span>
            </div>
            <p class:list={['pc-q', { 'pc-q--long': c.q.length > 80 }]} set:html={c.html} />
            <a class="pc-link" href={progUrl(c.prog)} tabindex={i === 0 ? 0 : -1}><span>How we help</span><b>{c.prog.name}</b><Icon name="arrow" /></a>
            <span class="pc-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </article>
        ))}
      </div>
      <div class="pb-answer">
        <p><b>If not,</b> we will work with you and your team to bring about the change.</p>
        <div class="btns">
          <a href="/contact/" class="btn btn--teal">Talk to DG <Icon name="arrow" class="arr" /></a>
          <a href="/programs/" class="btn btn--ghost">See the programs</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pb { position: relative; color: #fff;
    background:
      radial-gradient(ellipse 55% 70% at 0% 100%, rgba(36,178,163,.34), transparent 70%),
      radial-gradient(ellipse 45% 60% at 8% 0%, rgba(85,214,201,.16), transparent 70%),
      radial-gradient(ellipse 50% 70% at 100% 0%, rgba(15,113,104,.5), transparent 70%),
      linear-gradient(120deg, #10302c 0%, #1b1d1f 38%, #1d2224 62%, #0f2b28 100%); padding: clamp(56px, 6vw, 88px) 0; overflow: hidden; isolation: isolate; }
  /* dotted grid + drifting glows */
  .pb::before { content: ""; position: absolute; inset: 0; z-index: -1; background-image: radial-gradient(rgba(255,255,255,.07) 1px, transparent 1.4px); background-size: 26px 26px; mask-image: radial-gradient(ellipse at 70% 50%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 70% 50%, #000 20%, transparent 75%); }
  .pb-blob { position: absolute; z-index: -2; border-radius: 50%; filter: blur(70px); opacity: .45; pointer-events: none; }
  .pb-blob--a { width: 460px; height: 460px; background: var(--teal-600); right: 6%; top: -120px; }
  .pb-blob--b { width: 420px; height: 420px; background: var(--teal-600); left: -140px; bottom: -180px; }

  .pb-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .pb h2 { font-size: clamp(2.1rem, 3.8vw, 3.2rem); margin-bottom: 14px; }
  .pb-intro { color: rgba(255,255,255,.7); font-size: 1.02rem; max-width: 440px; margin-bottom: 30px; }

  .pb-controls { display: flex; gap: 12px; }
  .pb-btn { width: 56px; height: 56px; border-radius: 50%; border: 1px solid rgba(255,255,255,.22); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; transition: background .3s, color .3s, border-color .3s, transform .3s var(--ease); }
  .pb-btn:hover { background: var(--teal); border-color: var(--teal); color: var(--grey-950); transform: scale(1.06); }
  .pb-btn :global(svg) { width: 20px; height: 20px; }

  /* the deck */
  .pb-stage { display: grid; gap: 34px; }
  .pb-deck { position: relative; height: clamp(320px, 30vw, 380px); margin: 0 64px 34px 0; perspective: 1600px; }
  .pb-card { position: absolute; inset: 0; display: flex; flex-direction: column; padding: clamp(26px, 3vw, 40px); border-radius: 28px; overflow: hidden; transform-origin: 50% 100%;
    transition: transform .6s cubic-bezier(.22,1,.36,1), opacity .45s ease, box-shadow .6s; box-shadow: 0 30px 60px -24px rgba(0,0,0,.65); will-change: transform; }
  .pb-card[data-pos="0"] { transform: none; z-index: 10; }
  .pb-card[data-pos="1"] { transform: translate(30px, 18px) rotate(3.5deg) scale(.955); z-index: 9; }
  .pb-card[data-pos="2"] { transform: translate(56px, 34px) rotate(7deg) scale(.91); z-index: 8; }
  .pb-card[data-pos="3"] { transform: translate(64px, 40px) rotate(8deg) scale(.88); z-index: 1; opacity: 0; }
  .pb-card.leaving { transform: translate(-118%, -30px) rotate(-16deg) scale(.96); opacity: 0; z-index: 11; }
  .pb-card.snap { transition: none !important; }
  .pb-card:not([data-pos="0"]) .pc-q, .pb-card:not([data-pos="0"]) .pc-link { opacity: .35; }
  .pb-card--dark { background: linear-gradient(150deg, #2f3134, var(--grey-900)); color: #fff; border: 1px solid rgba(255,255,255,.08); }
  .pb-card--teal { background: linear-gradient(150deg, #6be0d4, var(--teal-600)); color: var(--grey-950); }
  .pb-card--cream { background: linear-gradient(150deg, #fffdf8, #ece8df); color: var(--ink); }
  .pc-top { display: flex; justify-content: space-between; align-items: center; }
  .pc-tag { font-size: .72rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; padding: 7px 12px; border-radius: 999px; background: rgba(255,255,255,.1); }
  .pb-card--teal .pc-tag { background: rgba(25,26,28,.12); }
  .pb-card--cream .pc-tag { background: var(--teal-50); color: var(--teal-ink); }
  .pc-ic { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: var(--teal); color: var(--grey-950); }
  .pb-card--teal .pc-ic { background: var(--grey-950); color: var(--teal); }
  .pc-ic :global(svg) { width: 22px; height: 22px; }
  .pc-q { position: relative; z-index: 1; font-family: var(--display); font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 1.14; font-weight: 600; margin: 22px 0 auto; text-wrap: balance; transition: opacity .5s; }
  .pc-q :global(em) { font-style: italic; color: var(--teal); }
  .pc-q--long { font-size: clamp(1.45rem, 2.3vw, 2.05rem); }
  .pb .pb-card--dark .pc-q { color: #fff; }
  .pb .pb-card--teal .pc-q { color: var(--grey-950); }
  .pb .pb-card--cream .pc-q { color: var(--ink); }
  .pb-card--teal .pc-q :global(em) { color: #0a4a44; }
  .pb-card--cream .pc-q :global(em) { color: var(--teal-ink); }
  .pc-link { position: relative; z-index: 1; align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; padding: 10px 16px; border-radius: 999px; font-size: .88rem; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); transition: background .3s, transform .3s var(--ease), opacity .5s; }
  .pb-card--teal .pc-link { background: rgba(25,26,28,.1); border-color: rgba(25,26,28,.18); }
  .pb-card--cream .pc-link { background: #fff; border-color: var(--grey-200); }
  .pc-link span { opacity: .7; }
  .pc-link :global(svg) { width: 16px; height: 16px; transition: transform .4s var(--ease); }
  .pc-link:hover { transform: translateY(-2px); }
  .pc-link:hover :global(svg) { transform: translateX(4px); }
  .pc-num { position: absolute; right: -10px; bottom: -48px; font-family: var(--display); font-size: clamp(9rem, 15vw, 13rem); font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px currentColor; opacity: .14; pointer-events: none; }

  .pb-answer { display: flex; align-items: center; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,.12); padding-top: 24px; }
  .pb-answer p { margin: 0; font-family: var(--display); font-size: clamp(1.15rem, 1.8vw, 1.45rem); font-style: italic; color: rgba(255,255,255,.9); max-width: 460px; }
  .pb-answer b { color: var(--teal); font-style: normal; }

  @media (prefers-reduced-motion: reduce) {
    .pb-blob { animation: none; }
    .pb-card { transition: opacity .4s ease; }
    .pb-card[data-pos="1"], .pb-card[data-pos="2"] { transform: none; opacity: 0; }
    .pb-card.leaving { transform: none; }
  }
  @media (max-width: 960px) {
    .pb-grid { grid-template-columns: 1fr; }
    .pb-deck { margin: 0 34px 26px 0; }
    .pb-card[data-pos="1"] { transform: translate(16px, 12px) rotate(2.5deg) scale(.96); }
    .pb-card[data-pos="2"] { transform: translate(30px, 22px) rotate(5deg) scale(.92); }
  }
  @media (max-width: 560px) {
    .pb-deck { height: 330px; }
    .pb-answer .btns { width: 100%; }
  }
</style>

<script>
  const INTERVAL = 3000;

  function initPlaybook() {
    const root = document.querySelector<HTMLElement>('[data-playbook]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const cards = [...root.querySelectorAll<HTMLElement>('.pb-card')];
    const n = cards.length;
    let i = 0, busy = false, hover = false, timer = 0;

    const layout = () => cards.forEach((c, k) => {
      const pos = (k - i + n) % n;
      c.dataset.pos = String(Math.min(pos, 3));
      c.setAttribute('aria-hidden', String(pos !== 0));
      c.querySelector('a')?.setAttribute('tabindex', pos === 0 ? '0' : '-1');
    });

    const go = (to: number) => {
      to = (to + n) % n;
      if (busy || to === i) return;
      busy = true;
      if ((to - i + n) % n === 1) {
        // top card sweeps off to the left and tucks in at the back
        const out = cards[i];
        out.classList.add('leaving');
        i = to;
        cards.forEach((c, k) => { if (c !== out) c.dataset.pos = String(Math.min((k - i + n) % n, 3)); });
        setTimeout(() => {
          out.classList.add('snap'); out.classList.remove('leaving');
          layout();
          requestAnimationFrame(() => requestAnimationFrame(() => out.classList.remove('snap')));
          busy = false;
        }, 480);
      } else {
        // going back: the previous card flies in from the left onto the top
        const incoming = cards[to];
        incoming.classList.add('snap', 'leaving');
        i = to;
        requestAnimationFrame(() => requestAnimationFrame(() => {
          incoming.classList.remove('snap', 'leaving');
          layout();
          setTimeout(() => (busy = false), 500);
        }));
      }
      schedule();
    };

    const schedule = () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => { if (hover || document.hidden) schedule(); else go(i + 1); }, INTERVAL);
    };

    root.querySelector('.pb-next')!.addEventListener('click', () => go(i + 1));
    root.querySelector('.pb-prev')!.addEventListener('click', () => go(i - 1));
    const deck = root.querySelector('.pb-deck')!;
    deck.addEventListener('mouseenter', () => (hover = true));
    deck.addEventListener('mouseleave', () => (hover = false));
    let x0 = 0;
    deck.addEventListener('touchstart', (e) => { x0 = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', (e) => { const dx = (e as TouchEvent).changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1); });

    layout(); schedule();
    document.addEventListener('astro:before-swap', () => clearTimeout(timer), { once: true });
  }

  document.addEventListener('astro:page-load', initPlaybook);
</script>
