---
// Ascending staircase: stages of a journey, each step higher than the last, with linked items on each step.
interface Props { steps: { stage: string; note: string; items: { label: string; href?: string }[] }[]; top: string }
const { steps, top } = Astro.props;
const n = steps.length;
---
<div class="stair" data-stagger>
  {steps.map((s, i) => (
    <div class:list={['st', { 'st--top': i === n - 1 }]} style={`--h:${120 + i * 70}px`}>
      <div class="st-items">{s.items.map((it) => it.href ? <a href={it.href}>{it.label}</a> : <span>{it.label}</span>)}</div>
      <div class="st-block">
        <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
        <b>{s.stage}</b>
        <small>{s.note}</small>
      </div>
    </div>
  ))}
  <div class="st-top" aria-hidden="true"><span>{top}</span></div>
</div>

<style>
  .stair { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; align-items: end; padding-top: 44px; }
  .st { display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; }
  .st-items { display: flex; flex-direction: column; gap: 6px; }
  .st-items a, .st-items span { display: block; background: #fff; border: 1px solid var(--grey-200); border-radius: 10px; padding: 8px 12px; font-size: .84rem; font-weight: 700; color: var(--ink); transition: border-color .3s, transform .4s var(--ease), background .3s; }
  .st-items a:hover { border-color: var(--teal); background: var(--teal-50); transform: translateY(-2px); }
  .st-block { height: var(--h); min-height: 120px; border-radius: 14px 14px 0 0; padding: 18px 16px; display: flex; flex-direction: column; gap: 4px; color: #fff; background: linear-gradient(180deg, var(--grey-800), var(--grey-950)); position: relative; overflow: hidden; }
  .st--top .st-block { background: linear-gradient(180deg, var(--teal-600), var(--teal-ink)); }
  .st-block::after { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--teal); }
  .st-n { font-family: var(--display); font-size: 1.8rem; font-weight: 600; color: var(--teal); line-height: 1; }
  .st--top .st-n { color: #fff; }
  .st-block b { font-size: 1.05rem; }
  .st-block small { font-size: .78rem; opacity: .75; line-height: 1.35; }
  .st-top { position: absolute; right: 0; top: 0; }
  .st-top span { display: inline-block; font-family: var(--display); font-style: italic; font-size: 1.15rem; color: var(--teal-ink); border-bottom: 2px solid var(--teal); padding-bottom: 2px; }
  @media (max-width: 900px) {
    .stair { grid-template-columns: 1fr; height: auto; gap: 12px; padding-top: 0; }
    .st { flex-direction: column-reverse; height: auto; }
    .st-block { height: auto; min-height: 0; border-radius: 14px; margin-left: calc((var(--h) - 120px) * .35); }
    .st-items { flex-direction: row; flex-wrap: wrap; margin-left: calc((var(--h) - 120px) * .35); }
    .st-top { position: static; text-align: right; }
  }
</style>
