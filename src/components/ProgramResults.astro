---
// Results bento: each outcome as a tile, plus a dark tile on how the change is measured.
import Icon from './Icon.astro';
import { type Program, rich } from '../lib/site';
interface Props { p: Program }
const { p } = Astro.props;
const icons = ['trend', 'heart', 'users', 'target', 'sparkle', 'check', 'chart'];
---
<div class="res" data-stagger>
  {(p.outcomes as string[]).map((o, i) => (
    <div class="res-t">
      <span class="res-ic"><Icon name={icons[i % icons.length]} /></span>
      <p set:html={rich(o)} />
      <span class="res-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
    </div>
  ))}
  <div class="res-t res-m on-dark">
    <span class="res-k"><Icon name="chart" /> How we measure it</span>
    <p set:html={rich(p.impact)} />
  </div>
</div>

<style>
  .res { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .res-t { position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; gap: 14px; padding: 24px; border-radius: 22px; background: #fff; border: 1px solid var(--grey-200); transition: transform .5s var(--ease), box-shadow .5s var(--ease), border-color .4s; }
  .res-t:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--teal); }
  .res-ic { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: var(--teal-50); color: var(--teal-ink); transition: background .4s, color .4s; }
  .res-t:hover .res-ic { background: var(--teal); color: var(--grey-950); }
  .res-ic :global(svg) { width: 22px; height: 22px; }
  .res-t p { margin: 0; font-size: 1.02rem; font-weight: 600; color: var(--ink); line-height: 1.45; }
  .res-n { position: absolute; z-index: -1; right: 12px; bottom: -22px; font-family: var(--display); font-size: 6rem; font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1.2px rgba(36,178,163,.25); }
  .res-m { justify-content: center; border: 0; background: radial-gradient(ellipse 90% 90% at 100% 0%, rgba(85,214,201,.3), transparent 60%), linear-gradient(150deg, #23282a, #12302c); }
  .res-m p { color: rgba(255,255,255,.88); font-weight: 500; font-size: .98rem; }
  .res-k { display: inline-flex; align-items: center; gap: 10px; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--teal); }
  .res-k :global(svg) { width: 18px; height: 18px; }
  /* stretch the measure tile so the last row is always full */
  .res:has(> .res-t:nth-child(5):last-child) .res-m { grid-column: span 2; }
  .res:has(> .res-t:nth-child(7):last-child) .res-m { grid-column: span 3; }
  @media (max-width: 960px) {
    .res { grid-template-columns: 1fr 1fr; }
    .res .res-m { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) { .res { grid-template-columns: 1fr; } }
</style>
