---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/Gallery.astro';
import ProgramSnapshot from '../../components/ProgramSnapshot.astro';
import ModuleExplorer from '../../components/ModuleExplorer.astro';
import ProgramResults from '../../components/ProgramResults.astro';
import ProgramDiagram from '../../components/ProgramDiagram.astro';
import { PROGRAMS, type Program, bySlug, rich, dots, wa, workFor, workUrl, WORK } from '../../lib/site';
import { photo, album } from '../../lib/photos';

export function getStaticPaths() {
  return PROGRAMS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Program };
const title = p.page_title ?? p.name;
const tagline = p.page_tagline ?? p.tagline;
const intro = p.intro ?? p.card;
const related = (p.related as string[]).map(bySlug);

// Gallery: the client engagement linked to this program, else the one the hero photo comes from
const galleryWork = workFor(p.slug)[0] ?? WORK.find((w) => p.hero.startsWith(w.key + '/'))!;
const galleryPhotos = album(galleryWork.key);

// The program-specific part of DG's bio ("… — and his core expertise is …")
const trainerAngle = p.trainer_bio?.split(' — ').slice(1).join(' — ').replace(/^and (is )?/, '').replace(/\.$/, '').replace(/^./, (c: string) => c.toUpperCase());

const sections = p.full
  ? [['overview', 'Overview'], ['glance', 'At a glance'], ['curriculum', 'Curriculum'], ['results', 'Results'], ['audience', 'Who attends'], ['floor', 'In action'], ['faqs', 'FAQs']]
  : [];
---
<Base title={`${title} — ${tagline}`} description={intro} active="programs">
  <section class="phero on-dark">
    <div class="phero-bg"><Image src={photo(p.hero)} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="chev-deco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb" data-hero><a href="/">Home</a><span>/</span><a href="/programs/">Programs</a><span>/</span><span aria-current="page">{p.short}</span></nav>
        <span class="eyebrow" data-hero>{`Program ${p.num}`} · {p.tag}</span>
        <h1 data-split>{title}</h1>
        <p class="tagline" data-hero>{tagline}</p>
        <p class="intro" data-hero>{intro}</p>
        <div class="btns" data-hero>
          <a href={`/contact/?program=${p.slug}`} class="btn btn--teal">Enquire Now <Icon name="arrow" class="arr" /></a>
          <a href={wa(`Hi DG Trainings, I'd like to know more about ${p.name}.`)} class="btn btn--ghost" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp Us</a>
        </div>
      </div>
      <ProgramSnapshot p={p} trainerAngle={trainerAngle} />
    </div>
  </section>

  {sections.length > 0 && (
    <nav class="subnav" aria-label="On this page"><div class="wrap"><div class="sn-track">{sections.map(([id, l], i) => <a href={`#${id}`}><i>{String(i + 1).padStart(2, '0')}</i>{l}</a>)}</div></div></nav>
  )}

  {p.full ? (
    <>
      <section class="section section--white" id="overview">
        <div class="wrap split">
          <div>
            <span class="eyebrow">Overview</span>
            <h2 data-split>{p.overview_h}</h2>
            {p.overview.map((t: string) => <p class="lead" data-reveal>{t}</p>)}
            <div class="method" data-reveal>
              <span class="method-k">How it’s taught</span>
              <ul>{dots(p.method).map((m) => <li set:html={rich(m)} />)}</ul>
            </div>
          </div>
          <div class="frame" data-img style="aspect-ratio:4/5"><Image src={photo(p.img)} alt={`${p.name} — DG Trainings session`} widths={[500, 800]} sizes="(max-width: 960px) 100vw, 540px" /></div>
        </div>
      </section>

      <section class="section section--tint" id="glance"><div class="wrap"><ProgramDiagram p={p} /></div></section>

      <section class="section section--white" id="curriculum">
        <div class="wrap">
          <div class="head head--row">
            <div>
              <span class="eyebrow">The curriculum</span>
              <h2 data-split>{p.modules.length} modules, <em>tailored to you</em></h2>
            </div>
            <p class="lead" data-reveal>Pick a module to see what it covers. Every example is built on your own products and customers.</p>
          </div>
          <ModuleExplorer modules={p.modules} id={`mx-${p.slug}`} />
          {p.optional_track && <div class="note" style="margin-top:24px" data-reveal><b>{p.optional_track[0]}</b><br /><span set:html={rich(p.optional_track[1])} /></div>}
        </div>
      </section>

      <section class="section section--tint" id="results">
        <div class="wrap">
          <div class="head"><span class="eyebrow">Results</span><h2 data-split>{p.outcomes_h}</h2></div>
          <ProgramResults p={p} />
        </div>
      </section>

      <section class="section section--white" id="audience">
        <div class="wrap cols2" data-stagger>
          <div class="panel">
            <span class="eyebrow">Who should attend</span>
            <h3>Built for</h3>
            <ul class="ticks ticks--1">{p.attend.map((a: string) => <li>{a}</li>)}</ul>
          </div>
          {p.takeaways ? (
            <div class="panel panel--dark on-dark">
              <span class="eyebrow">{p.takeaways_label}</span>
              <h3>{p.takeaways_label === 'Take-aways' ? 'Your team leaves with' : 'Inside the sessions'}</h3>
              <ul class="ticks ticks--1">{dots(p.takeaways).map((m) => <li>{m}</li>)}</ul>
            </div>
          ) : (
            <div class="frame" style="min-height:300px"><Image src={photo(p.hero)} alt={`${p.name} in session`} widths={[500, 800]} sizes="(max-width: 960px) 100vw, 560px" /></div>
          )}
        </div>
      </section>
    </>
  ) : (
    <>
      <section class="section section--white">
        <div class="wrap split">
          <div>
            <span class="eyebrow">Overview</span>
            <h2 data-split>{p.tagline}</h2>
            <p class="lead" data-reveal>{p.card}</p>
            <div class="note" style="margin-top:24px" data-reveal>
              {p.note ? <span set:html={rich(p.note)} /> : <span>The module-by-module curriculum is shared on a discovery call and built around your team. <mark class="tbc">Detailed page content to be added</mark></span>}
            </div>
            <div class="btns" style="margin-top:28px" data-reveal>
              <a href={`/contact/?program=${p.slug}`} class="btn">Request the curriculum <Icon name="arrow" class="arr" /></a>
            </div>
          </div>
          <div class="frame" data-img style="aspect-ratio:4/5"><Image src={photo(p.img)} alt={`${p.name} — DG Trainings`} widths={[500, 800]} sizes="(max-width: 960px) 100vw, 540px" /></div>
        </div>
      </section>
      <section class="section section--tint"><div class="wrap"><ProgramDiagram p={p} /></div></section>
    </>
  )}

  <section class:list={['section', p.full ? 'section--tint' : 'section--white']} id="floor">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <span class="eyebrow">On the training floor</span>
          <h2 data-split>Inside a session at <em>{galleryWork.client}</em></h2>
        </div>
        <p class="lead" data-reveal><span set:html={rich(galleryWork.blurb)} /> <a class="link-arrow" href={workUrl(galleryWork)}>Full gallery <Icon name="arrow" /></a></p>
      </div>
      <Gallery photos={galleryPhotos} alt={`${galleryWork.client} training session`} layout="strip" />
    </div>
  </section>

  {p.full && (
    <section class="section section--white" id="faqs">
      <div class="wrap">
        <div class="head center"><span class="eyebrow">FAQs</span><h2 data-split>About this <em>program</em></h2></div>
        <Faq items={p.faqs} />
      </div>
    </section>
  )}

  <section class="section section--tint">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Keep exploring</span><h2 data-split>Explore Our <em>Other Programs</em></h2></div>
      <div class="grid3 rail" data-stagger>{related.map((r) => <ProgramCard p={r} compact />)}</div>
    </div>
  </section>

  <CtaBand heading={p.cta_h ?? `Bring ${p.short} to your team.`} text={p.cta_text ?? 'Book a free discovery call — we’ll show you how this program fits your business, team and targets.'} primary="Book a Free Discovery Call" bg={p.img} compact />
</Base>

<style>
  .method { margin-top: 26px; padding: 20px 22px; border-radius: 20px; background: var(--grey-50); border: 1px solid var(--grey-100); }
  .method-k { display: block; font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--teal-ink); margin-bottom: 12px; }
  .method ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .method li { font-size: .86rem; font-weight: 600; padding: 8px 13px; border-radius: 999px; background: #fff; border: 1px solid var(--grey-200); color: var(--ink); }
</style>
